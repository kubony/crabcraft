@@ -0,0 +1,60 @@
+"""jumper.power_jumpspin720 -- jumper.power_jumpspin with the turn capped at two turns.
+
+Everything is `jumper.power_jumpspin`'s (its `env_cfg.py` has the design) but the
+cap both turn rewards share: `landed_turn` pays most for landing exactly two turns
+round (the tent at 720 degrees rather than 360), and `flight_turn_rate` pays the
+yaw rate in the air until the flight has turned two turns.
+
+## Why a task of its own
+
+`pw-jspin720` was trained from the experiment branch `exp/power-jumpspin-720`
+(543ed55), whose one change from `jumper.power_jumpspin` is this cap, resumed from
+`pw-jspin-L`'s `model_2998`. It lands 708 degrees in the air on average (635 to
+756, 32 of 32 upright, native:cpu, DR on; `docs/CRABCRAFT_POWER.md`). That is the
+jump spin "World of Crabcraft" ships, and an export is only reproducible against
+the task it trained on, so the cap is a task here rather than a branch.
+
+`pw-jspin720` trained under the id `jumper.power_jumpspin` (its logs say so), on
+this configuration without the handover below.
+
+## The handover start
+
+Every HOME spawn starts the way the bundle's controller hands a mode over
+(`power_jumpspin.env_cfg.handover_start`, `power_jumpspin/mdp/handover.py`): up to
+0.1 rad off HOME on every gait joint, held at HOME with the action at zero for
+0.02 to 0.6 s, and handed to the policy with its observation history emptied.
+`pw-jspin720` took off only from mjlab's reset, whose first observation shows the
+servo's limit on 18 of the 20 joints' torque; from a robot standing at HOME it
+did not jump. `pw-jspin720-ho`, resumed from its `model_3997` on this
+configuration, is what ships (`docs/CRABCRAFT_POWER.md`, "The handover start").
+"""
+
+from __future__ import annotations
+
+import math
+from pathlib import Path
+
+from mjlab.envs import ManagerBasedRlEnvCfg
+
+from ..power_jumpspin import env_cfg as jumpspin_env
+
+#: Two turns: the tent's peak and the in-air rate's ceiling, in radians.
+LANDED_TURN_CAP = 4 * math.pi
+
+
+def env_cfg(asset: Path | None = None, play: bool = False) -> ManagerBasedRlEnvCfg:
+    """The jump spin, two turns.
+
+    Args:
+        asset: path to the model XML, from `--model`. None uses the default jumper.xml.
+        play: replay mode -- noise and pushes off, every episode from HOME, handed
+            over after `power_jumpspin.env_cfg.PLAY_HOLD_S` of standing.
+    """
+    cfg = jumpspin_env.env_cfg(asset=asset, play=play)
+    cfg.rewards["landed_turn"].params["cap"] = LANDED_TURN_CAP
+    cfg.rewards["flight_turn_rate"].params["cap"] = LANDED_TURN_CAP
+    cfg = jumpspin_env.handover_start(cfg, play)
+    return jumpspin_env.settle_after_landing(cfg)
+
+
+__all__ = ["env_cfg"]
