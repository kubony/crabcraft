+            ref = train_cfg.observations.get(gname)
+            if ref is None:
+                continue
+            group.enable_corruption = ref.enable_corruption
+            for tname, term in group.terms.items():
+                if tname in ref.terms:
+                    term.noise = ref.terms[tname].noise
+    cfg.scene.num_envs = args.envs
+    cfg.seed = args.seed
+    agent_cfg = tasks.load_agent_cfg(task)
+    env = ManagerBasedRlEnv(cfg=cfg, device="cpu")
+    wrapped = RslRlVecEnvWrapper(env, clip_actions=agent_cfg.clip_actions)
+    runner_cls = tasks.load_runner_cls(task) or MjlabOnPolicyRunner
+    runner = runner_cls(wrapped, asdict(agent_cfg), device="cpu")
+    runner.load(str(args.checkpoint), load_cfg={"actor": True}, strict=True, map_location="cpu")
+    policy = runner.get_inference_policy(device="cpu")
+
+    cmd = env.command_manager.get_term("motion")
+    robot = env.scene["robot"]
+    # The command advances its frame after each step and wraps (teleporting the robot
+    # back to frame 0) when it reaches the end, so one pass observes frames 0..total-2:
+    # the robot after k steps is scored against frame k, as the reward scores it.
+    n = int(cmd.motion.time_step_total) - 1
+    dt = env.step_dt
+    obs = wrapped.get_observations()
+    # reset puts every env on frame 0 (sampling "start")
+    obs, _ = wrapped.reset() if hasattr(wrapped, "reset") and callable(wrapped.reset) else (obs, None)
+    if isinstance(obs, tuple):
+        obs = obs[0]
+
+    E = args.envs
+    q = np.zeros((n, E, 22))
+    qref = np.zeros((n, E, 22))
+    pos = np.zeros((n, E, 3))
+    pref = np.zeros((n, E, 3))
+    quat = np.zeros((n, E, 4))
+    qtref = np.zeros((n, E, 4))
+    ts = np.zeros((n, E), dtype=np.int64)
+    nb = len(cmd.cfg.body_names)
+    bpos = np.zeros((n, E, nb, 3))
+    bref = np.zeros((n, E, nb, 3))
+    alive = np.ones(E, dtype=bool)
+    fell_at = np.full(E, np.nan)
+    why: list[str] = [""] * E
+    tau_peak = np.zeros(E)
+    origins = env.scene.env_origins.cpu().numpy()
+
+    def sample(k: int) -> None:
+        q[k] = robot.data.joint_pos.cpu().numpy()
+        ai = cmd.motion_anchor_body_index
+        qref[k] = cmd.motion.joint_pos[k].cpu().numpy()[None]
+        pos[k] = cmd.robot_anchor_pos_w.cpu().numpy() - origins
+        pref[k] = cmd.motion.body_pos_w[k, ai].cpu().numpy()[None]
+        quat[k] = cmd.robot_anchor_quat_w.cpu().numpy()
+        qtref[k] = cmd.motion.body_quat_w[k, ai].cpu().numpy()[None]
+        ts[k] = cmd.time_steps.cpu().numpy()
+        bpos[k] = cmd.robot_body_pos_w.cpu().numpy() - origins[:, None]
+        bref[k] = cmd.motion.body_pos_w[k].cpu().numpy()[None]
+
+    sample(0)
+    term_names = list(env.termination_manager.active_terms)
+    with torch.inference_mode():
+        for k in range(1, n):
+            act = policy(obs)
+            obs, _, dones, _ = wrapped.step(act)
+            tau = robot.data.actuator_force.abs().max(dim=-1).values.cpu().numpy()
+            tau_peak = np.where(alive, np.maximum(tau_peak, tau), tau_peak)
+            done = dones.cpu().numpy().astype(bool)
+            for e in np.nonzero(done & alive)[0]:
+                alive[e] = False
+                fell_at[e] = k * dt
+                fired = [t for t in term_names if bool(env.termination_manager.get_term(t)[e])]
+                why[e] = ",".join(fired)
+            sample(k)
+
+    t = np.arange(n) * dt
+    names = list(robot.joint_names)
+    home = np.array([float(cmd.motion.joint_pos[0, j]) for j in range(22)])
+    ok_rows = np.ones((n, E), dtype=bool)
+    for e in range(E):
+        if not math.isnan(fell_at[e]):
+            ok_rows[t >= fell_at[e] - 1e-9, e] = False
+
+    def rms_deg(err: np.ndarray, mask: np.ndarray) -> float:
+        sel_ = err[mask]
+        return float(np.degrees(np.sqrt(np.mean(sel_ ** 2)))) if sel_.size else float("nan")
+
+    events = clip_events(args.move)
+    if args.move in BREAK_WINDOWS:
+        a, b = (float(events[e]) for e in BREAK_WINDOWS[args.move])
+    else:
+        a, b = WINDOWS[args.move]
+    win = (t >= a - 1e-9) & (t <= b + 1e-9)
+    err = q - qref
+    still = home[None, None, :] - qref  # a policy standing at HOME
+    m_all = ok_rows
+    m_win = ok_rows & win[:, None]
+    zerr_mm = np.abs(pos[..., 2] - pref[..., 2]) * 1000
+    terr = np.abs(tilt_deg(quat) - tilt_deg(qtref))
+    # joint error per joint over the window, worst joint
+    per_joint = np.degrees(np.sqrt(np.mean((err[win] ** 2).reshape(-1, 22), axis=0)))
+    end = ok_rows[-1]
+    end_home = np.degrees(np.sqrt(np.mean((q[-1] - home) ** 2, axis=-1)))
+    metrics = {
+        "move": args.move, "dr": args.dr, "envs": E, "checkpoint": str(args.checkpoint),
+        "clip_s": round(n * dt, 3), "window": [a, b],
+        "falls": int((~alive).sum()), "fell_at": [None if math.isnan(x) else round(float(x), 2) for x in fell_at],
+        "terminations": [w for w in why if w],
+        "joint_rms_deg_whole": round(rms_deg(err, m_all), 2),
+        "joint_rms_deg_window": round(rms_deg(err, m_win), 2),
+        "standstill_rms_deg_window": round(rms_deg(still, np.broadcast_to(win[:, None], still.shape[:2])), 2),
+        "worst_joint_window": [names[int(np.argmax(per_joint))], round(float(per_joint.max()), 2)],
+        "base_z_err_mm_median_max": [round(float(np.median(zerr_mm[m_all])), 2), round(float(zerr_mm[m_all].max()), 2)],
+        "tilt_err_deg_median_max": [round(float(np.median(terr[m_all])), 2), round(float(terr[m_all].max()), 2)],
+        "end_rms_from_home_deg": [round(float(x), 2) for x in end_home],
+        "end_base_z_mm": [round(float(x) * 1000, 1) for x in pos[-1, :, 2]],
+        "end_alive": int(end.sum()),
+        "peak_torque_Nm_max": round(float(tau_peak.max()), 3),
+    }
+
+    # How big the move is, against the reference's: joint excursion from HOME (RMS)
+    # and joint speed (RMS of the step-to-step difference), over the window.
+    def amp_ratio(x: np.ndarray, xr: np.ndarray, mask: np.ndarray) -> float:
+        num, den = x[mask], xr[mask]
+        return float(np.sqrt(np.mean(num ** 2)) / max(np.sqrt(np.mean(den ** 2)), 1e-9))
+
+    dq = np.diff(q, axis=0) / dt
+    dqr = np.diff(qref, axis=0) / dt
+    m_vel = m_win[1:] & ok_rows[:-1]
+    metrics["motion_ratio_window"] = round(amp_ratio(q - home, qref - home, m_win), 3)
+    metrics["speed_ratio_window"] = round(amp_ratio(dq, dqr, m_vel), 3)
+
+    # The base's heading and its drift off the reference's path, over the clip.
+    yaw = yaw_deg(quat)
+    yaw_ref = yaw_deg(qtref)
+    last_ok = np.array([int(np.nonzero(ok_rows[:, e])[0].max()) for e in range(E)])
+    turned = np.array([yaw[last_ok[e], e] - yaw[0, e] for e in range(E)])
+    turned_ref = float(yaw_ref[-1, 0] - yaw_ref[0, 0])
+    yerr = np.abs(yaw - yaw_ref)
+    drift_mm = np.linalg.norm(pos[..., :2] - pref[..., :2], axis=-1) * 1000
+    metrics["yaw_turned_deg_ref"] = round(turned_ref, 1)
+    metrics["yaw_turned_deg"] = [round(float(x), 1) for x in turned]
+    metrics["yaw_err_deg_median_max_end"] = [round(float(np.median(yerr[m_all])), 2),
+                                             round(float(yerr[m_all].max()), 2),
+                                             round(float(np.median(yerr[-1])), 2)]
+    metrics["base_drift_mm_median_max_end"] = [round(float(np.median(drift_mm[m_all])), 1),
+                                               round(float(drift_mm[m_all].max()), 1),
+                                               round(float(np.median(drift_mm[-1])), 1)]
+
+    # The freezes: are the lifted feet (and the one claw) actually up while the pose is held?
+    # A foot's lift is its height above where it stood at frame 0; "up" is at least half the
+    # reference's lift at that frame, for every lifted foot at once.
+    if args.move in BREAK_HOLDS:
+        (h0, h1), lifted = BREAK_HOLDS[args.move]
+        h0, h1 = float(events[h0]), float(events[h1])
+        hold = (t >= h0 - 1e-9) & (t <= h1 + 1e-9)
+        m_hold = ok_rows & hold[:, None]
+        bodies = list(cmd.cfg.body_names)
+        bi = [bodies.index(b_) for b_ in lifted]
+        lift = (bpos[:, :, bi, 2] - bpos[0][None, :, bi, 2]) * 1000  # (n, E, k) mm
+        lift_ref = (bref[:, :, bi, 2] - bref[0][None, :, bi, 2]) * 1000
+        up = np.all(lift >= 0.5 * lift_ref, axis=-1)
+
+        def min_median(x: np.ndarray) -> list:
+            return [round(float(x.min()), 1), round(float(np.median(x)), 1)] if x.size else [None, None]
+
+        hold_rows = np.broadcast_to(hold[:, None], m_hold.shape)
+        tilt_p, tilt_r = tilt_deg(quat), tilt_deg(qtref)
+        metrics["hold"] = [h0, h1]
+        metrics["hold_alive"] = int(m_hold[hold].all(axis=0).sum())
+        metrics["hold_lift_mm"] = {
+            b_: {"policy_min_median": min_median(lift[..., j][m_hold]),
+                 "ref_min_median": min_median(lift_ref[..., j][hold_rows])}
+            for j, b_ in enumerate(lifted)
+        }
+        metrics["hold_lifted_up_fraction"] = round(float(up[m_hold].mean()), 3) if m_hold.any() else 0.0
+        metrics["hold_tilt_deg_policy_ref_median"] = [
+            round(float(np.median(tilt_p[m_hold])), 1) if m_hold.any() else None,
+            round(float(np.median(tilt_r[hold_rows])), 1)]
