@@ -0,0 +1,247 @@
+{
+  "schema": "kk-deploy-manifests/1",
+  "_source": "Maintained by hand, as deploy/manifests.json is. `python scripts/deploy.py --manifests deploy/crabcraft.manifests.json` builds the bundle in it.",
+  "_why": [
+    "World of Crabcraft's bundle: the jumper bundle, the six skills that game plays,",
+    "jumper.skill_* (docs/CRABCRAFT_SKILLS.md), and its breakdance: four tracked moves,",
+    "jumper.break_* (docs/CRABCRAFT_BREAKING.md), and its three power moves, the spin,",
+    "jumper.power_spin_feet, the 720 jump spin, jumper.power_jumpspin720, and the back flip,",
+    "jumper.power_backflip (docs/CRABCRAFT_POWER.md). In a file of its own so that",
+    "deploy/manifests.json keeps the one bundle `python scripts/deploy.py` builds without",
+    "being told which. Read deploy/manifests.json's `_controls` and `_hooks` first: they",
+    "hold for this file word for word."
+  ],
+  "bundles": {
+    "crabcraft": {
+      "description": "The jumper bundle (every mode, switch and leave as it has them) plus the six skills \"World of Crabcraft\" plays, jumper.skill_*: on Menu + A, X, Y, LB, RB and L3 on the pad, and 5 6 7 8 9 0 on the keyboard (either row), from locomotion; and its breakdance, the toprock, the six-step, the claw stand, the one-claw freeze, the spin, the 720 jump spin and the back flip: on Home + A, X, Y, L3, LB, RB and d-pad up on the pad, and Shift + 1 2 3 4 5 6 7 on the keyboard (either row), from locomotion. Menu (Ctrl) on its own leaves a skill or a breaking move as it leaves a dance or a gesture; the spin and the two jumps, which have no recording, also end on their own switch pressed again. The back flip's mode lifts the cascade's tilt fallback while it is active.",
+      "fsm": "crabcraft.controller.toml",
+      "_why": "A bundle of its own rather than six modes added to `jumper`, which is laid out as the robot's operator guide, Control-agent 3.1, and has no skills in it. The modes copied from `jumper` carry its fields without its comments; the `jumper` bundle in deploy/manifests.json is where each one is explained.",
+      "_reached_by": "The skills sit on Menu chords because every pad button alone is taken in locomotion (A the jump, LB and RB the claws, B the release, R3 the posture's shift) and the d-pad is the gestures'. While Menu is held the button answers only the chord. X and Y carry the dictionary's `unresolved` note: which physical button each is has not been pressed to settle. The keyboard's 5 6 7 8 9 0 sit next to the gestures' 1 2 3 4. The breaking moves sit on Home chords, on the skills' buttons held with the other button the pad has spare, and while Home is held the button answers only the chord (B stays the release's: the bundle check refuses a switch on a control locomotion reads); on the keyboard on Shift + 1 to 7, a row of their own beside the gestures' 1 to 4 and the dances' Ctrl + 1 to 4. The 720 jump spin takes the last of the skills' buttons, RB; the back flip goes on d-pad up held with Home, a layer of its own beside the gestures' d-pad alone and the dances' Menu + d-pad. Both jumps take off from the robot a mode switch hands over, standing at HOME (docs/CRABCRAFT_POWER.md, \"The handover start\").",
+      "leave": [
+        {
+          "name": "leave_motion",
+          "leaves": ["dance_crab", "dance_brazilian", "dance_maze", "dance_dream_wings", "gesture_hello", "gesture_bow", "gesture_paw", "gesture_salute", "skill_swipe", "skill_slam", "skill_cast", "skill_flinch", "skill_powerdown", "skill_sit", "break_toprock", "break_sixstep", "break_clawstand", "break_oneclaw", "power_spin", "power_jumpspin", "power_backflip"],
+          "pad": {
+            "button": "menu",
+            "on": "fall",
+            "from": ["dance_crab", "dance_brazilian", "dance_maze", "dance_dream_wings", "gesture_hello", "gesture_bow", "gesture_paw", "gesture_salute", "skill_swipe", "skill_slam", "skill_cast", "skill_flinch", "skill_powerdown", "skill_sit", "break_toprock", "break_sixstep", "break_clawstand", "break_oneclaw", "power_spin", "power_jumpspin", "power_backflip"]
+          },
+          "keys": {
