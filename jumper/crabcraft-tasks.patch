index 0000000..31afd96
--- /dev/null
+++ b/tasks/jumper/power_jumpspin/env_cfg.py
@@ -0,0 +1,301 @@
+"""jumper.power_jumpspin -- a jump that turns about the vertical axis in the air.
+
+The breaker's jump spin: up, turn half a turn or a whole one in the air, and
+land on the feet. Reward-driven; the jump it starts from is
+`jumper.ref_free_jump`'s.
+
+## Built on jumper.ref_free_jump, with the scaffolding taken down
+
+`ref_free_jump`'s config is the starting point, and almost all of it stays: the
+200 Hz control at kp=20, the actor's observation (406 wide, no clock, no
+recording), the flight bookkeeping that decides which flight is the episode's
+own jump, the height terms at their final weights, the landing at HOME, the
+penalties and the tilt limit.
+
+What goes is what that task needed only while it was learning to jump at all:
+the recording fed forward into the action and the joint prior on it, and the
+schedule that crossed them over into the height terms. The run starts from
+`ref_free_jump`'s `model_5999` instead (`rl_cfg.py`, `runner.py`), whose actor
+jumps on its own: its feedforward and prior were zero for its last 3000
+iterations. So the action term is a plain absolute target around HOME, the
+critic drops the two observations that described the feedforward, and there is
+no curriculum.
+
+The recording still supplies what `ref_free_jump`'s command reads it for: the go,
+and the reference-state spawns that practise the flight and the landing.
+
+## What it adds: the turn
+
+`mdp/commands.py` integrates the yaw rate, counter-clockwise from above, and
+latches what the own flight turned at its touchdown. `landed_turn` pays that
+latch every step after the landing, most for a landing exactly a full turn
+round, and `flight_turn_rate` pays the yaw rate while in the air until the
+flight has turned that far. Neither pays for turning on the ground; a turn
+begun before takeoff is paid for what it carries into the air.
+
+A full turn's latch pays `LANDED_TURN_WEIGHT` x 2 a step, against the apex's
+`APEX_WEIGHT` x 1.2 for a jump as high as the recording's: the turn is worth
+more than the height, and the height still buys the flight time the turn needs.
+
+## Terminations
+
+`ref_free_jump`'s, unchanged: time-out, back at HOME (a time-out), and a tilt
+past 50 degrees, the controller's own limit. A turned landing that tips over
+ends the episode as a failure and is paid nothing more.
+
+## Symmetry
+
+Off. A counter-clockwise turn's mirror image is a clockwise one; see
+`rl_cfg.py`.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import math
+from pathlib import Path
+from typing import Literal
+
+from mjlab.envs import ManagerBasedRlEnvCfg
+from mjlab.envs import mdp as envs_mdp
+from mjlab.envs.mdp.actions import JointPositionActionCfg
+from mjlab.managers.event_manager import EventTermCfg
+from mjlab.managers.observation_manager import ObservationTermCfg
+from mjlab.managers.reward_manager import RewardTermCfg
+from mjlab.managers.scene_entity_config import SceneEntityCfg
+
+from ..common.constants import GAIT_JOINTS
+from ..ref_free_jump import env_cfg as ref_free_env
+from . import mdp as turn_mdp
+
+#: The height terms at the weights `ref_free_jump` ends its schedule at.
+APEX_WEIGHT = ref_free_env.APEX_WEIGHT
+FLIGHT_WEIGHT = ref_free_env.FLIGHT_WEIGHT
+
+#: The latched turn, per half turn, paid every step after the landing, most for
+#: landing exactly a full turn round and less either side of it
+#: (`mdp/rewards.py::landed_turn`, `tent`).
+LANDED_TURN_WEIGHT = 4.0
+LANDED_TURN_CAP = 2 * math.pi
+
+#: The yaw rate in the air, per rad/s, until the flight has turned
+#: `LANDED_TURN_CAP`. Summed over a flight it is the flight's turn in radians:
+#: half a turn pays 3.1.
+FLIGHT_TURN_RATE_WEIGHT = 1.0
+
+# ── The handover start (`mdp/handover.py`), for the two shipped jumps ──────────
+#: Seconds a HOME spawn stands at HOME under its own PD before the policy acts,
+#: drawn per episode. From 0.02 s, a robot still settling from a pose up to
+#: `HANDOVER_POSE_RANGE` off HOME -- the controller hands over the moment every
+#: joint is inside its tolerance, measured 0.099 rad off and 0.20 rad/s on the
+#: worst joint -- to 0.6 s, a robot long settled: past about 0.3 s nothing the
+#: policy can see changes any more. Chosen to cover that span, not tuned.
+HANDOVER_HOLD_RANGE = (0.02, 0.6)
+
+#: Radians each gait joint may be off HOME at a HOME spawn, uniformly: the
+#: controller's `pose_reach_tol` (`deploy/crabcraft.controller.toml`), the
+#: furthest it hands over from.
+HANDOVER_POSE_RANGE = 0.10
+
+#: Replay's hold, every episode from HOME exactly: the 0.5 s of standing that
+#: `docs/CRABCRAFT_POWER.md` first measured the handover with.
+PLAY_HOLD_S = 0.5
+
+# ── Settling after the landing (`mdp/calm.py`), for the two shipped jumps ────
+#: Seconds after the episode begins settling (its landing) the settling terms
+#: start to count, and the seconds by which they count in full. The flip touches
+#: down 27 to 31 degrees nose-up and is level 0.2 to 0.3 s later; the catch is
+#: left alone.
+SETTLE_START_S = 0.2
+SETTLE_FULL_S = 0.5
+
+#: The settling charges (`mdp/calm.py`), per second of their value: the joints'
+#: summed squared speed, the action rate, the actuators' summed squared force and
+#: the squared roll and pitch rate. Four times the first guesses, -0.01, -0.1,
+#: -0.05 and -0.5, which set the flip's shaking at about 4 a second against the 16
+#: its latched turn and apex pay: at those, 1500 iterations from the shipped
+#: checkpoints halved the flip's joint speed and did not stop its torque chatter;
+#: at these, `cm-720-4x` and the flip at twice these were at rest within 1000
+#: more (`docs/CRABCRAFT_POWER.md`, "Settling after the landing").
+SETTLE_JOINT_VEL_WEIGHT = -0.04
+SETTLE_ACTION_RATE_WEIGHT = -0.4
+SETTLE_TORQUE_WEIGHT = -0.2
+SETTLE_ANG_VEL_WEIGHT = -2.0
+SETTLE_HOME_WEIGHT = 2.0
+SETTLE_HOME_SIGMA_SQ = 0.05
+
+#: The episode, from the reset, once settling is asked for: the longest hold
+#: (0.6 s), the jump (the 720 lands 0.7 s after the go), and 2.7 s or more of
+#: standing after it.
+SETTLE_EPISODE_S = 4.0
+
+
+def turning_jump_cfg(
+    asset: Path | None, play: bool, axis: Literal["yaw", "pitch"]
+) -> ManagerBasedRlEnvCfg:
+    """`ref_free_jump`'s config with its scaffolding taken down and the rotation
+    about `axis` counted. Shared with `jumper.power_backflip`, which sets its own
+    rewards and terminations on top."""
+    cfg = ref_free_env.env_cfg(asset=asset, play=play)
+
+    # The action: an absolute target around HOME, ref_free_jump's with the
+    # feedforward at the zero it ends at.
+    old = cfg.actions["joint_pos"]
+    cfg.actions["joint_pos"] = JointPositionActionCfg(
+        entity_name=old.entity_name,
+        actuator_names=list(GAIT_JOINTS),
+        scale=dict(old.scale),
+        use_default_offset=True,
+    )
+
+    # The command: ref_free_jump's, as it was configured (play's spawns included),
+    # counting the rotation.
+    jump = cfg.commands["jump"]
+    fields = {
+        f.name: getattr(jump, f.name)
+        for f in dataclasses.fields(jump)
+        if f.init and f.name != "class_type"
+    }
+    cfg.commands["jump"] = turn_mdp.commands.RotationJumpCommandCfg(**fields, axis=axis)
+
+    critic = cfg.observations["critic"].terms
+    for name in ("prior_target", "feedforward"):
+        del critic[name]
+    critic["turn_state"] = ObservationTermCfg(
+        func=turn_mdp.observations.turn_state,
+        params={"command_name": "jump", "mirror_kind": "scalar"},
+    )
+
+    for name in ("prior_joint_pos", "prior_joint_vel"):
+        del cfg.rewards[name]
+    cfg.rewards["apex_height"].weight = APEX_WEIGHT
+    cfg.rewards["flight_height"].weight = FLIGHT_WEIGHT
+    cfg.curriculum = {}
+    return cfg
+
+
+def handover_start(
+    cfg: ManagerBasedRlEnvCfg,
+    play: bool,
+    hold_range: tuple[float, float] | None = None,
+    pose_range: float | None = None,
+) -> ManagerBasedRlEnvCfg:
+    """Start every HOME spawn the way the bundle's controller hands a mode over:
+    up to `pose_range` off HOME, held there for a draw from `hold_range` with the
+    action at zero, and the observation history emptied at the go
+    (`mdp/handover.py`). The episode grows by the longest hold.
+
+    Defaults: `HANDOVER_HOLD_RANGE` and `HANDOVER_POSE_RANGE` in training;
+    `PLAY_HOLD_S` from HOME exactly in replay. Applied again to a config that has
+    it, it replaces the ranges, which is how `tools/eval_power.py` sets its own.
+    """
+    if hold_range is None:
+        hold_range = (PLAY_HOLD_S, PLAY_HOLD_S) if play else HANDOVER_HOLD_RANGE
+    if pose_range is None:
+        pose_range = 0.0 if play else HANDOVER_POSE_RANGE
+    lo, hi = hold_range
+    if not 0.0 <= lo <= hi:
+        raise ValueError(f"hold_range {hold_range} is not 0 <= lo <= hi")
+
+    cfg.commands["jump"].command_delay_range = (float(lo), float(hi))
+
+    # The action as it was configured, field for field, holding until the go.
+    old = cfg.actions["joint_pos"]
+    keep = {f.name for f in dataclasses.fields(turn_mdp.handover.HandoverJointPositionActionCfg)
+            if f.init}
+    cfg.actions["joint_pos"] = turn_mdp.handover.HandoverJointPositionActionCfg(
+        **{f.name: getattr(old, f.name) for f in dataclasses.fields(old)
+           if f.init and f.name in keep and f.name != "command_name"},
+        command_name="jump",
+    )
+
+    # The pose after HOME is written and before the reference-state spawns
+    # overwrite their share: reset events run in the dict's order.
+    events = {k: v for k, v in cfg.events.items()
+              if k not in ("handover_pose", "handover_history")}
+    out = {}
+    for name, term in events.items():
+        out[name] = term
+        if name == "reset_to_default" and pose_range > 0.0:
+            out["handover_pose"] = EventTermCfg(
+                func=envs_mdp.reset_joints_by_offset, mode="reset",
+                params={"position_range": (-pose_range, pose_range),
+                        "velocity_range": (0.0, 0.0),
+                        "asset_cfg": SceneEntityCfg("robot", joint_names=list(GAIT_JOINTS))},
+            )
+    if "reset_to_default" not in events:
+        raise ValueError("the handover pose goes after `reset_to_default`, which this config lacks")
+    out["handover_history"] = EventTermCfg(
+        func=turn_mdp.handover.handover_history, mode="step",
+        params={"command_name": "jump"},
+    )
+    cfg.events = out
+    cfg.episode_length_s = ref_free_env.EPISODE_S + float(hi)
+    return cfg
+
+
+def settle_after_landing(cfg: ManagerBasedRlEnvCfg) -> ManagerBasedRlEnvCfg:
+    """Ask for rest once the jump is over (`mdp/calm.py`), and give the episode
+    the time to be paid for it.
+
+    - the five settling terms, gated on the time since the episode began
+      settling: its landing, or the span run out for one that could have jumped
+      and did not; never for a spawn that could not jump;
+    - no `back_home` termination: it ended an episode 0.1 s after the robot
+      first stood at HOME, so standing there was never trained, and the flip,
+      which shook, never reached it;
+    - `SETTLE_EPISODE_S` long.
+
+    Applied after `handover_start`, which sets the episode's length too. The
+    actor's observation is untouched, and so is the critic's, so a run resumes
+    a checkpoint trained without these as it is.
+    """
+    gait = SceneEntityCfg("robot", joint_names=list(GAIT_JOINTS))
+    gait_act = SceneEntityCfg("robot", actuator_names=list(GAIT_JOINTS))
+    gate = {"command_name": "jump", "start_s": SETTLE_START_S, "full_s": SETTLE_FULL_S}
+    cfg.rewards["calm_joint_vel"] = RewardTermCfg(
+        func=turn_mdp.calm.calm_joint_vel, weight=SETTLE_JOINT_VEL_WEIGHT,
+        params={"asset_cfg": gait, **gate},
+    )
+    cfg.rewards["calm_action_rate"] = RewardTermCfg(
+        func=turn_mdp.calm.calm_action_rate, weight=SETTLE_ACTION_RATE_WEIGHT,
+        params=dict(gate),
+    )
+    cfg.rewards["calm_torque"] = RewardTermCfg(
+        func=turn_mdp.calm.calm_torque, weight=SETTLE_TORQUE_WEIGHT,
+        params={"asset_cfg": gait_act, **gate},
+    )
+    cfg.rewards["calm_base_ang_vel"] = RewardTermCfg(
+        func=turn_mdp.calm.calm_base_ang_vel, weight=SETTLE_ANG_VEL_WEIGHT,
+        params=dict(gate),
+    )
+    cfg.rewards["calm_home"] = RewardTermCfg(
+        func=turn_mdp.calm.calm_home, weight=SETTLE_HOME_WEIGHT,
+        params={"asset_cfg": gait, "sigma_sq": SETTLE_HOME_SIGMA_SQ, **gate},
+    )
+    cfg.terminations.pop("back_home", None)
+    cfg.episode_length_s = SETTLE_EPISODE_S
+    return cfg
+
+
+def env_cfg(asset: Path | None = None, play: bool = False) -> ManagerBasedRlEnvCfg:
+    """The jump spin.
+
+    Args:
+        asset: path to the model XML, from `--model`. None uses the default jumper.xml.
+        play: replay mode -- noise and pushes off, every episode from HOME.
+    """
+    cfg = turning_jump_cfg(asset, play, axis="yaw")
+    cfg.rewards["landed_turn"] = RewardTermCfg(
+        func=turn_mdp.rewards.landed_turn, weight=LANDED_TURN_WEIGHT,
+        params={"command_name": "jump", "scale": math.pi, "cap": LANDED_TURN_CAP,
+                "tent": True},
+    )
+    cfg.rewards["flight_turn_rate"] = RewardTermCfg(
+        func=turn_mdp.rewards.flight_turn_rate, weight=FLIGHT_TURN_RATE_WEIGHT,
+        params={"command_name": "jump", "cap": LANDED_TURN_CAP},
+    )
+    return cfg
+
+
+__all__ = ["env_cfg", "handover_start", "settle_after_landing", "turning_jump_cfg"]
