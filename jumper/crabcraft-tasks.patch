@@ -0,0 +1,21 @@
+"""Critic-only observations for jumper.power_spin.
+
+The drift penalty reads the base's distance from where the episode spawned,
+which nothing on the robot measures. The critic is thrown away at export, so it
+is shown that distance; the actor is not.
+"""
+
+from __future__ import annotations
+
+import torch
+from mjlab.entity import Entity
+
+
+def base_offset(env, scale: float = 0.10) -> torch.Tensor:
+    """The base's horizontal offset from the env origin, world frame, in units
+    of `scale` -- what `horizontal_drift` charges for."""
+    robot: Entity = env.scene["robot"]
+    return (robot.data.root_link_pos_w[:, :2] - env.scene.env_origins[:, :2]) / scale
+
+
+__all__ = ["base_offset"]
diff --git a/tasks/jumper/power_spin/mdp/rewards.py b/tasks/jumper/power_spin/mdp/rewards.py
new file mode 100644
index 0000000..bc098d5
--- /dev/null
+++ b/tasks/jumper/power_spin/mdp/rewards.py
@@ -0,0 +1,29 @@
+"""The spin objective.
+
+`spin_rate` is the whole objective: the base's yaw rate in the world frame,
+counter-clockwise seen from above, linear and signed. Signed so that turning
+back and forth averages to nothing and only a sustained turn pays; linear so
+that there is no target to settle at -- faster always pays more.
+
+The rest of what the policy is paid and charged for is `jumper.ref_free_jump`'s
+and is imported in `env_cfg.py`.
+"""
+
+from __future__ import annotations
+
+import torch
+from mjlab.entity import Entity
+
+
+def spin_rate(env, max_rate: float = 60.0) -> torch.Tensor:
+    """The base's world-frame yaw rate in rad/s, counter-clockwise positive.
+
+    Clamped to +/- `max_rate` only so that one simulation blow-up cannot write a
+    reward of thousands into a batch; 60 rad/s is ten turns a second, far past
+    anything the servos can drive.
+    """
+    robot: Entity = env.scene["robot"]
+    return robot.data.root_link_ang_vel_w[:, 2].clamp(-max_rate, max_rate)
+
+
+__all__ = ["spin_rate"]
diff --git a/tasks/jumper/power_spin/rl_cfg.py b/tasks/jumper/power_spin/rl_cfg.py
new file mode 100644
index 0000000..50d81f5
--- /dev/null
+++ b/tasks/jumper/power_spin/rl_cfg.py
@@ -0,0 +1,33 @@
+"""PPO hyperparameters for jumper.power_spin."""
+
+from __future__ import annotations
+
+from mjlab.rl import RslRlOnPolicyRunnerCfg
+
+from ..common.ppo import jumper_ppo_baseline
+
+
+def agent_cfg() -> RslRlOnPolicyRunnerCfg:
+    return jumper_ppo_baseline(
+        experiment_name="jumper.power_spin",
+        # Off: the spin is counter-clockwise by design, and its mirror image is
+        # the clockwise one. See `env_cfg.py`.
+        symmetry=False,
+        use_data_augmentation=False,
+        use_mirror_loss=False,
+        actor_hidden_dims=(512, 256, 128, 64),
+        critic_hidden_dims=(512, 256, 128, 64),
+        # 0.5 in action units is 0.25 rad of target noise at this scale, the
+        # walking tasks' exploration in radians (1.0 at scale 0.25). The motion
+        # here has to be found, not refined from a recording, so it starts wider
+        # than ref_free_jump's 0.3.
+        init_std=0.5,
+        entropy_coef=0.002,
+        # ref_free_jump's 200 Hz correction: the fourth root keeps the baseline's
+        # 2 s horizon at four times the control rate.
+        gamma=0.99**0.25,
+        lam=0.95**0.25,
+        # A rollout is a duration: 48 steps at 200 Hz is 0.24 s, as in ref_free_jump.
+        num_steps_per_env=48,
+        max_iterations=3000,
+    )
