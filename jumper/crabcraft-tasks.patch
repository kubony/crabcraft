@@ -0,0 +1,152 @@
+"""Environment config for jumper.break_sixstep: a crab six-step, `media/sixstep.npz`.
+
+The environment is `tasks/jumper/common/dance/env.py`; this file holds every
+number. Where a number follows a rule `jumper.dance` wrote down for its own clip,
+the rule is applied to this clip's measurements and the result is quoted -- read
+`tasks/jumper/dance/env_cfg.py` for the reasoning behind each rule.
+
+## This clip, measured
+
+At the 50 Hz control rate, after conversion (5.32 s, lead-out and hold included):
+per-joint position std 0.140 rad at the median and 0.360 at the most active, RMS
+amplitude 0.188 rad; joint velocity RMS 4.872 rad/s, per-joint std 3.485 at the
+median and 9.026 at the most active, peaking at 29.9 rad/s; the base between
+96 and 106 mm; tilt at most 0.0 degrees.
+
+**Trained** (docs/CRABCRAFT_BREAKING.md, "Trained"): what training on this clip
+changed from jumper.dance's recipe is below, the smoothness weights, the stds of the
+two global root terms, and two terms in the critic.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from mjlab.envs import ManagerBasedRlEnvCfg
+from mjlab.managers.observation_manager import ObservationTermCfg
+from mjlab.tasks.tracking import mdp
+
+from ..common.dance.env import COMMAND, dance_env_cfg
+
+#: This task's material, written by `tools/author_breaking_clips.py`.
+MEDIA = Path(__file__).resolve().parent / "media"
+
+#: Episode length, seconds. Half the 5.32 s clip, jumper.dance_maze's rule for a
+#: short clip: the command teleports the robot back onto the reference wherever an
+#: episode runs off the end, and at half the clip an episode sampled in its first
+#: half runs clean.
+EPISODE_S = 2.66
+
+
+def env_cfg(asset: Path | None = None, play: bool = False) -> ManagerBasedRlEnvCfg:
+    """Build this task's environment config. See `jumper.dance`'s for the arguments."""
+    cfg = dance_env_cfg(
+        media=MEDIA,
+        asset=asset,
+        play=play,
+        episode_s=EPISODE_S,
+        # ── Reference-state initialisation ────────────────────────────────
+        # jumper.dance's: fractions of this robot (10 mm is a tenth of its
+        # standing height), not of the clip, so they carry over unchanged.
+        rsi_pose_range={
+            "x": (-0.01, 0.01), "y": (-0.01, 0.01), "z": (-0.005, 0.005),
+            "roll": (-0.05, 0.05), "pitch": (-0.05, 0.05), "yaw": (-0.05, 0.05),
+        },
+        rsi_velocity_range={
+            "x": (-0.1, 0.1), "y": (-0.1, 0.1), "z": (-0.05, 0.05),
+            "roll": (-0.2, 0.2), "pitch": (-0.2, 0.2), "yaw": (-0.2, 0.2),
+        },
+        rsi_joint_range=(-0.05, 0.05),
+        # ── Observation noise ─────────────────────────────────────────────
+        # The tracking skeleton's, as jumper.dance has them; not measured.
+        joint_pos_noise=0.01,
+        joint_vel_noise=0.5,
+        # ── Rewards ───────────────────────────────────────────────────────
+        # Positive budget 6.5 a step, as jumper.dance: mjlab's six tracking
+        # terms unchanged (5.0) plus the two joint-space terms below (1.5).
+        #
+        # Joint position: jumper.dance's rule is a std at 0.44 of the clip's
+        # RMS amplitude. Here: 0.44 x 0.188 -> 0.08. Standing still through
+        # the whole clip scores 0.269, and over the move alone, 4.42 s, 0.127.
+        joint_pos_std=0.08,
+        joint_pos_weight=1.0,
+        # Joint velocity: two thirds of the clip's velocity RMS. Here: 4.872
+        # -> 3.25, and over the moving half of the clip standing still scores
+        # 0.070. Half the position weight, so when they disagree the pose
+        # wins.
+        joint_vel_std=3.25,
+        joint_vel_weight=0.5,
+        # Smoothness: **not jumper.dance's -0.1 and -0.05, by the power
+        # term's rule.** Against the servo's damping (kd 0.5 on the joint's
+        # own speed) a policy can hold this clip's speed only by leading the
+        # reference by kd * qd / kp, 1.5 rad at the rear knees' 29.9 rad/s; the
+        # actions that do it change by 15.3 a step squared and summed
+        # (second difference 21.0) over the move, where -0.1 and -0.05
+        # would charge 39.7% of the positive budget, a price on keeping
+        # up with the turn (the toprock and the freezes: 0.1 to 0.2%).
+        # A policy trained with them (job 248840) swung its rear knees half
+        # as far as the clip and turned 325 of the 360 degrees. Scaled
+        # together to 3.2%.
+        action_rate_weight=-0.008,
+        action_acc_weight=-0.004,
+        # Power: **not jumper.dance's -0.02, by jumper.dance's rule.** The rule
+        # is a typical step costing about 3% of the positive budget, enough to
+        # break ties and not enough to buy its way out of dancing. 22 joints at
+        # ~0.25 N*m and this clip's ~4.87 rad/s is ~26.8 W, where -0.02 would be
+        # -0.54 a step, 8.2% of the budget, a price on keeping up with the
+        # turn. -0.007 is -0.19 a step, 2.9%.
+        power_weight=-0.007,
+        # Torque above the continuous rating: anchored to the servo, not the
+        # clip -- one joint at the plateau costs 0.6, 9% of the budget.
+        torque_headroom_weight=-2.0,
+        # Joint limits. The reference stays inside the soft joint limits
+        # throughout, so this term charges a faithful policy nothing.
+        joint_limit_weight=-10.0,
+        # Leg-on-leg contact above 1.0 N, ~8% of the robot's worst-case push.
+        self_collision_weight=-1.0,
+        self_collision_force=1.0,
+        # ── Terminations ──────────────────────────────────────────────────
+        # Root height: this clip moves the body through 96-106 mm, a 10 mm
+        # band, so 40 mm exceeds all of it and cannot fire on a policy merely
+        # tracking badly -- jumper.dance's rule, and its number.
+        #
+        # The base travels 524 mm round the pivot and turns 360 degrees; the
+        # tracking terms read the anchor's pose in the world, and the clip
+        # ends facing the way it started, so the lead-out does not turn back.
+        anchor_height_error=0.04,
+        # 1 - cos(tilt) = 0.3 is 45.6 degrees, "has fallen over"; the clip
+        # leans 0.0.
+        anchor_tilt_error=0.3,
+        # A support foot 50 mm out vertically is half the standing height. It
+        # is an error against the reference, so a foot the clip lifts is not
+        # one.
+        support_foot_error=0.05,
+        # ── Disturbance ───────────────────────────────────────────────────
+        # jumper.dance's: gentler and rarer than mjlab's, sized to a 2 kg
+        # robot.
+        push_interval_s=(3.0, 8.0),
+        push_velocity_range={
+            "x": (-0.1, 0.1), "y": (-0.1, 0.1), "z": (-0.05, 0.05),
+            "roll": (-0.2, 0.2), "pitch": (-0.2, 0.2), "yaw": (-0.2, 0.2),
+        },
+    )
+    # The turn itself. mjlab's two global root terms keep a humanoid's stds,
+    # 0.3 m and 0.4 rad, under which this robot's base 80 mm off the
+    # reference's path still scores 0.93 and 25 degrees short of the turn
+    # 0.30: a policy tracking the joints to 2.6 degrees turned 334 of the 360
+    # (job 249247). Tightened for the six-step, the one clip whose base goes
+    # anywhere.
+    cfg.rewards["motion_global_root_pos"].params["std"] = 0.05
+    cfg.rewards["motion_global_root_ori"].params["std"] = 0.2
+    # The actor cannot see where the base is or which way it faces (no state
+    # estimator, and the IMU's yaw drifts: `ref_tilt_error`), so the turn is
+    # open loop and what it learns is a bias. The critic, thrown away at export,
+    # is shown the base's error against the reference so that it can price
+    # that bias; jumper.dance's critic has only the body poses relative to the
+    # base, which read nothing of a turn that fell short.
+    critic = cfg.observations["critic"].terms
+    critic["anchor_pos_error"] = ObservationTermCfg(
+        func=mdp.motion_anchor_pos_b, params={"command_name": COMMAND})
+    critic["anchor_ori_error"] = ObservationTermCfg(
+        func=mdp.motion_anchor_ori_b, params={"command_name": COMMAND})
+    return cfg
