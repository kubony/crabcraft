diff --git a/tasks/jumper/skill_swipe/rl_cfg.py b/tasks/jumper/skill_swipe/rl_cfg.py
new file mode 100644
index 0000000..e91d918
--- /dev/null
+++ b/tasks/jumper/skill_swipe/rl_cfg.py
@@ -0,0 +1,50 @@
+"""Hyper-parameters for jumper.skill_swipe.
+
+jumper.dance's, value for value, as for the gestures, and for the reasons written
+out in `tasks/jumper/dance/rl_cfg.py`: the network, PPO and runner settings were
+chosen for imitating a clip on this robot, not for that one clip. Written out again
+rather than imported, so that changing one clip's training is a change to that clip.
+"""
+
+from __future__ import annotations
+
+from mjlab.rl import RslRlOnPolicyRunnerCfg
+
+from ..common.ppo import jumper_ppo_baseline
+
+
+def agent_cfg() -> RslRlOnPolicyRunnerCfg:
+    """This task's rsl_rl config: `logs/<model>/jumper.skill_swipe/<date-time>`."""
+    return jumper_ppo_baseline(
+        experiment_name="jumper.skill_swipe",
+        # Off, and not a tuning choice: the swipe is right-handed, and
+        # mirroring its samples would train the average of a right-handed and
+        # a left-handed swipe. `symmetry.py` would also refuse the reference
+        # terms.
+        symmetry=False,
+        use_data_augmentation=False,
+        use_mirror_loss=False,
+        actor_hidden_dims=(512, 256, 128, 64),
+        critic_hidden_dims=(512, 256, 128, 64),
+        init_std=1.0,
+        # Half the baseline's: imitation needs less exploration than
+        # locomotion, and a rising `Policy/mean_std` costs precision terms
+        # first.
+        entropy_coef=0.005,
+        learning_rate=1.0e-3,
+        desired_kl=0.01,
+        gamma=0.99,
+        lam=0.95,
+        num_learning_epochs=5,
+        num_mini_batches=4,
+        num_steps_per_env=24,
+        max_iterations=10_000,
+    )
+
+
+def runner_cls() -> type:
+    """mjlab's motion-tracking runner, as jumper.dance: it logs the tracking metrics
+    and the adaptive sampler's entropy, and bakes the clip into the exported ONNX."""
+    from mjlab.tasks.tracking.rl import MotionTrackingOnPolicyRunner
+
+    return MotionTrackingOnPolicyRunner
diff --git a/tests/test_deploy_hook.py b/tests/test_deploy_hook.py
index fe1a81a..430b337 100644
--- a/tests/test_deploy_hook.py
+++ b/tests/test_deploy_hook.py
@@ -182,3 +182,99 @@ def test_each_device_s_switch_reaches_the_cascade_as_its_own_binding(tmp_path) -
     (tmp_path / "cascade.toml").write_text(CASCADE + '\n[fsm.keyboard]\nkey_g = "LB"\n', "utf-8")
     with pytest.raises(SystemExit, match=r"\[fsm\.keyboard\]"):
         deploy.compose_fsm(spec, detail, models, manifest)
+
+
+def test_a_modes_skip_tilt_check_reaches_its_state_and_only_its_own(tmp_path) -> None:
+    """`skip_tilt_check` on a manifest mode arrives in that mode's `[[fsm.state]]` and
+    in what the bundle records it was built from; every other mode's state goes
+    without it, so the crate's default -- the `tilted` fallback armed -- stays theirs.
+
+    A flip mode needs the fallback lifted (it passes upside down), and nothing else
+    does: the failure on one side is a flip dropped to `safe` in the air, on the
+    other a mode that tips past the limit with nothing to catch it. So the composed
+    file is read back as TOML and every state is checked, the walking state and a
+    mode that says `false` out loud being the control group. Anything but a JSON
+    boolean is refused rather than read as one.
+    """
+    import copy
+
+    import tomllib
+
+    deploy = _deploy_module()
+    export = tmp_path / "export"
+    export.mkdir()
+    (export / "layout.json").write_text("{}", "utf-8")
+    (tmp_path / "cascade.toml").write_text(CASCADE, "utf-8")
+    manifest = tmp_path / "manifests.json"
+    spec = {"fsm": "cascade.toml", "modes": {
+        "walk": {"task": "jumper.tripod", "policy": str(export)},
+        "slow": {"task": "jumper.tripod", "policy": str(export), "pad": {"button": "A"},
+                 "skip_tilt_check": False},
+        "flip": {"task": "jumper.power_backflip", "policy": str(export),
+                 "keys": {"key": ["key_7"], "with": "shift"}, "skip_tilt_check": True},
+    }}
+
+    modes, detail = deploy.manifest_modes(spec, manifest)
+    assert detail["flip"]["skip_tilt_check"] is True, "bundle.json's built_from would not record it"
+    assert "skip_tilt_check" not in detail["walk"] and "skip_tilt_check" not in detail["slow"]
+    text = deploy.compose_fsm(spec, detail, {m: f"{m}.onnx" for m in modes}, manifest)
+    states = {s["name"]: s for s in tomllib.loads(text)["fsm"]["state"]}
+    assert states["flip"]["skip_tilt_check"] is True
+    assert states["flip"]["task"] == "jumper.power_backflip"
+    assert [n for n, s in states.items() if s.get("skip_tilt_check")] == ["flip"]
+    assert "skip_tilt_check" not in states["safe"]
+
+    for wrong in ("true", 1, None):
+        broken = copy.deepcopy(spec)
+        broken["modes"]["flip"]["skip_tilt_check"] = wrong
+        with pytest.raises(SystemExit, match="'flip''s `skip_tilt_check` is"):
+            deploy.manifest_modes(broken, manifest)
+
+
+def test_a_modes_target_margin_reaches_its_state_and_only_its_own(tmp_path) -> None:
+    """`target_margin` on a manifest mode arrives in that mode's `[[fsm.state]]`, as a
+    TOML float, and in what the bundle records it was built from; every other mode's
+    state goes without it, so the crate's default -- targets clamped at the stops --
+    stays theirs.
+
+    The 720 and the spin point their targets past the stops, and training clamped
+    nothing; every other mode was measured under the clamp and keeps it. A margin of
+    0 is the default said out loud and writes nothing. Anything but a JSON number of
+    0 or more is refused: `true` would otherwise arrive as 1 rad.
+    """
+    import copy
+
+    import tomllib
+
+    deploy = _deploy_module()
+    export = tmp_path / "export"
+    export.mkdir()
+    (export / "layout.json").write_text("{}", "utf-8")
+    (tmp_path / "cascade.toml").write_text(CASCADE, "utf-8")
+    manifest = tmp_path / "manifests.json"
+    spec = {"fsm": "cascade.toml", "modes": {
+        "walk": {"task": "jumper.tripod", "policy": str(export)},
+        "slow": {"task": "jumper.tripod", "policy": str(export), "pad": {"button": "A"},
+                 "target_margin": 0},
+        "spin": {"task": "jumper.power_jumpspin720", "policy": str(export),
+                 "keys": {"key": ["key_6"], "with": "shift"}, "target_margin": 1.7},
+        "twirl": {"task": "jumper.power_spin_feet", "policy": str(export),
+                  "keys": {"key": ["key_5"], "with": "shift"}, "target_margin": 2},
+    }}
+
+    modes, detail = deploy.manifest_modes(spec, manifest)
+    assert detail["spin"]["target_margin"] == 1.7, "bundle.json's built_from would not record it"
+    assert detail["twirl"]["target_margin"] == 2.0
+    assert "target_margin" not in detail["walk"] and "target_margin" not in detail["slow"]
+    text = deploy.compose_fsm(spec, detail, {m: f"{m}.onnx" for m in modes}, manifest)
+    states = {s["name"]: s for s in tomllib.loads(text)["fsm"]["state"]}
+    assert states["spin"]["target_margin"] == 1.7
+    assert isinstance(states["twirl"]["target_margin"], float), "an integer TOML value"
+    assert sorted(n for n, s in states.items() if "target_margin" in s) == ["spin", "twirl"]
+    assert "target_margin" not in states["safe"]
+
+    for wrong in (True, "1.7", -0.1, float("nan"), float("inf"), None, [1.7]):
+        broken = copy.deepcopy(spec)
+        broken["modes"]["spin"]["target_margin"] = wrong
+        with pytest.raises(SystemExit, match="'spin''s `target_margin` is"):
+            deploy.manifest_modes(broken, manifest)
diff --git a/tests/test_power_handover.py b/tests/test_power_handover.py
new file mode 100644
index 0000000..14c8074
--- /dev/null
+++ b/tests/test_power_handover.py
@@ -0,0 +1,180 @@
+"""The two shipped jumps start the way the bundle's controller hands a mode over.
+
+`jumper.power_jumpspin720` and `jumper.power_backflip` took off only from mjlab's
+reset, whose first observation shows the servo's torque limit on 18 of the 20
+joints, and from a robot standing at HOME they did not jump
+(`docs/CRABCRAFT_POWER.md`). `power_jumpspin/mdp/handover.py` starts every HOME
+spawn the controller's way instead. What is pinned here is what fails silently:
+
+- the hold has to reach the action manager's own copy of the action, or the
+  actor's `actions` observation shows the policy's discarded output while the
+  robot stands at HOME, which the controller never shows it;
+- the history has to be emptied at the go, or the first frame the policy acts on
+  sits behind four frames the controller would not have;
+- the reference-state spawns must come after the handover pose, or they spawn
+  mid-flight with their joints knocked off the recording.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+SHIPPED = ("jumper.power_jumpspin720", "jumper.power_backflip")
+
+
+@pytest.mark.parametrize("task", SHIPPED)
+def test_the_shipped_jumps_train_from_the_handover(task: str) -> None:
+    import tasks
+    from tasks.jumper.power_jumpspin import env_cfg as jumpspin_env
+    from tasks.jumper.power_jumpspin.mdp.handover import HandoverJointPositionActionCfg
+    from tasks.jumper.ref_free_jump import env_cfg as ref_free_env
+
+    cfg = tasks.load_env_cfg(task)
+    assert isinstance(cfg.actions["joint_pos"], HandoverJointPositionActionCfg)
+    assert cfg.actions["joint_pos"].use_default_offset
+    assert cfg.commands["jump"].command_delay_range == jumpspin_env.HANDOVER_HOLD_RANGE
+    lo, hi = jumpspin_env.HANDOVER_HOLD_RANGE
+    assert lo > 0.0, "a zero hold is mjlab's reset, the start this replaces"
+    # The longest hold and the jump fit; the settling after it makes it longer
+    # (`test_power_settle.py`).
+    assert cfg.episode_length_s >= ref_free_env.EPISODE_S + hi
+
+    resets = [n for n, t in cfg.events.items() if t.mode == "reset"]
+    assert resets.index("reset_to_default") < resets.index("handover_pose") \
+        < resets.index("reset_from_reference")
+    r = jumpspin_env.HANDOVER_POSE_RANGE
+    assert cfg.events["handover_pose"].params["position_range"] == (-r, r)
+    assert cfg.events["handover_history"].mode == "step"
+
+    play = tasks.load_env_cfg(task, play=True)
+    hold = jumpspin_env.PLAY_HOLD_S
+    assert play.commands["jump"].command_delay_range == (hold, hold)
+    assert "handover_pose" not in play.events
+    assert "handover_history" in play.events
+
+
+def test_the_full_turn_keeps_its_own_start() -> None:
+    """`jumper.power_jumpspin` is not shipped and its runs trained without it."""
+    import tasks
+    from tasks.jumper.power_jumpspin.mdp.handover import HandoverJointPositionActionCfg
+
+    cfg = tasks.load_env_cfg("jumper.power_jumpspin")
+    assert not isinstance(cfg.actions["joint_pos"], HandoverJointPositionActionCfg)
+    assert cfg.commands["jump"].command_delay_range == (0.0, 0.0)
+    assert "handover_history" not in cfg.events
+
+
+def test_the_hold_is_zero_everywhere_and_the_go_hands_over_one_frame() -> None:
+    """Step a real environment with large random actions: while held, the target
+    is HOME and the manager's action is zero; at the go every history frame is
+    the go's own, the last action zero; after it, the policy's action applies."""
+    from mjlab.sim import get_simulation_cls, set_simulation_cls
+    from mjrl.backend import native_sim, select
+    from mjrl.backend.resolve import resolve
+
+    # `use_backend` sets two module globals; put them back afterwards, as
+    # `test_dance_motion.py` explains, or this test's `n` becomes
+    # `test_resolve.py`'s thread count.
+    saved_cls = get_simulation_cls()
+    saved_nthread = native_sim._DEFAULT_NTHREAD
+    n = 3
+    res = resolve(backend="native", device="cpu", num_envs=n)
+    select.use_backend(res)
+    try:
+        _hold_and_go(n, res)
+    finally:
+        set_simulation_cls(saved_cls)
+        native_sim._DEFAULT_NTHREAD = saved_nthread
+
+
+def _hold_and_go(n: int, res) -> None:
+    import torch
+    from mjlab.envs import ManagerBasedRlEnv
+
+    import tasks
+    from tasks.jumper.power_jumpspin.env_cfg import handover_start
+
+    cfg = tasks.load_env_cfg("jumper.power_jumpspin720")
+    for name in ("base_com", "encoder_bias", "foot_friction", "push_robot"):
+        cfg.events.pop(name, None)
+    cfg.events["reset_from_reference"].params["rsi_fraction"] = 0.0
+    cfg.commands["jump"].rsi_fraction = 0.0
+    handover_start(cfg, play=False, hold_range=(0.05, 0.12), pose_range=0.1)
+    cfg.scene.num_envs = n
+    cfg.sim.device = res.device
+
+    env = ManagerBasedRlEnv(cfg, device=res.device)
+    try:
+        obs, _ = env.reset()
+        cmd = env.command_manager.get_term("jump")
+        go = cmd.go_step.clone()
+        assert bool((go >= 0.05 / env.step_dt - 1e-6).all())
+        robot = env.scene["robot"]
+        term = env.action_manager.get_term("joint_pos")
+        ids = term.target_ids
+        home = robot.data.default_joint_pos[:, ids]
+        group = env.observation_manager
+        names = group.active_terms["actor"]
+        dims = [int(torch.tensor(d).prod()) for d in group.group_obs_term_dim["actor"]]
+        start = dict(zip(names, torch.tensor([0, *dims]).cumsum(0).tolist()))
+        width = dict(zip(names, dims))
+
+        handed = torch.zeros(n, dtype=torch.bool)
+        gen = torch.Generator().manual_seed(0)
+        for _ in range(int(0.2 / env.step_dt)):
+            k = env.episode_length_buf.clone().float()
+            act = 2.0 * torch.randn(n, env.action_manager.total_action_dim, generator=gen)
+            obs, *_ = env.step(act)
+            held = k < go
+            if held.any():
+                assert torch.all(env.action_manager.action[held] == 0.0)
+                assert torch.allclose(robot.data.joint_pos_target[:, ids][held], home[held])
+            if (~held).any():
+                assert torch.allclose(env.action_manager.action[~held], act[~held])
+            now = (env.episode_length_buf.float() >= go) & ~handed
+            for e in now.nonzero().flatten().tolist():
+                x = obs["actor"][e]
+                for name in ("joint_pos", "joint_vel", "actions", "actuator_force"):
+                    frames = x[start[name]:start[name] + width[name]].view(5, -1)
+                    assert torch.allclose(frames, frames[-1:].expand_as(frames)), (
+                        f"env {e}: {name}'s history at the go is not one frame"
+                    )
+                actions = x[start["actions"]:start["actions"] + width["actions"]]
+                assert torch.all(actions == 0.0)
+            handed |= now
+        assert bool(handed.all())
+    finally:
+        env.close()
+
+
+def test_the_flips_clawback_mirrors_the_rate_it_takes_back() -> None:
+    """`turn_clawback` returns what `flight_turn_rate` paid, so it cancels it only
+    at the same weight, negated, and with the same cap: anything else leaves a
+    crash or a hop part of its pay, which the policy farms (`mdp/rewards.py`)."""
+    import tasks
+
+    cfg = tasks.load_env_cfg("jumper.power_backflip")
+    rate, claw = cfg.rewards["flight_turn_rate"], cfg.rewards["turn_clawback"]
+    assert claw.weight == -rate.weight
+    assert claw.params["cap"] == rate.params["cap"]
+    assert claw.params.get("max_rate", 60.0) == rate.params.get("max_rate", 60.0)
+    assert claw.params.get("charge_crash", True)
+
+
+def test_the_flips_bridge_comes_down_to_the_handover() -> None:
+    """The reset share starts where the curriculum starts it and reaches 0 inside
+    the shipped run's 1500 iterations from `pw-flip-T`'s `model_2498`, and replay
+    has none of it."""
+    import tasks
+    from tasks.jumper.power_backflip import env_cfg as flip_env
+    from tasks.jumper.ref_free_jump.rl_cfg import NUM_STEPS_PER_ENV
+
+    cfg = tasks.load_env_cfg("jumper.power_backflip")
+    term = cfg.curriculum["reset_share"]
+    assert cfg.commands["jump"].reset_share == term.params["start_share"] == flip_env.BRIDGE_SHARE
+    assert term.params["end_share"] == 0.0
+    assert term.params["end_step"] <= NUM_STEPS_PER_ENV * (2498 + 1500)
+    play = tasks.load_env_cfg("jumper.power_backflip", play=True)
+    assert play.commands["jump"].reset_share == 0.0
+    assert "reset_share" not in play.curriculum
+    assert tasks.load_env_cfg("jumper.power_jumpspin720").commands["jump"].reset_share == 0.0
diff --git a/tests/test_power_settle.py b/tests/test_power_settle.py
new file mode 100644
index 0000000..4bcdf0b
--- /dev/null
+++ b/tests/test_power_settle.py
@@ -0,0 +1,144 @@
+"""The two shipped jumps are asked to come to rest after the landing.
+
+`pw-flip-brc`'s back flip shook for as long as it was left running after its
+landing, and the 720 had never been trained to stand anywhere: `back_home` ended
+its episodes 0.1 s after it first reached HOME (`docs/CRABCRAFT_POWER.md`,
+"Settling after the landing"). `power_jumpspin/mdp/calm.py` charges motion once
+the jump is over. What is pinned here is what fails silently:
+
+- the terms must be gated, or the takeoff and the catch are charged as shaking;
+- the gate must count from the jump being over, landed or not, or a policy that
+  does not jump dodges the charge;
+- and never for a spawn that could not jump: charged with nothing to lose, the
+  policy learnt to end such episodes by falling over;
+- `back_home` must be gone and the episode long enough, or there is no standing
+  after the landing to pay for.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+SHIPPED = ("jumper.power_jumpspin720", "jumper.power_backflip")
+SETTLE_TERMS = ("calm_joint_vel", "calm_action_rate", "calm_torque", "calm_base_ang_vel",
+                "calm_home")
+
+
+@pytest.mark.parametrize("task", SHIPPED)
+def test_the_shipped_jumps_are_asked_to_settle(task: str) -> None:
+    import tasks
+    from tasks.jumper.power_jumpspin import env_cfg as jumpspin_env
+    from tasks.jumper.ref_free_jump import env_cfg as ref_free_env
+
+    for play in (False, True):
+        cfg = tasks.load_env_cfg(task, play=play)
+        assert "back_home" not in cfg.terminations
+        assert "time_out" in cfg.terminations
+        assert cfg.episode_length_s == pytest.approx(jumpspin_env.SETTLE_EPISODE_S)
+    cfg = tasks.load_env_cfg(task)
+    _, hi = jumpspin_env.HANDOVER_HOLD_RANGE
+    # The longest hold, the jump and its way home as ref_free_jump timed them,
+    # and a second more of standing.
+    assert cfg.episode_length_s >= hi + ref_free_env.EPISODE_S + 0.9
+    for name in SETTLE_TERMS:
+        term = cfg.rewards[name]
+        assert term.params["start_s"] == jumpspin_env.SETTLE_START_S
+        assert term.params["full_s"] == jumpspin_env.SETTLE_FULL_S
+        assert (term.weight > 0) == (name == "calm_home"), name
+    if task == "jumper.power_backflip":
+        from tasks.jumper.power_backflip import env_cfg as flip_env
+
+        assert cfg.rewards["calm_joint_vel"].weight == pytest.approx(
+            jumpspin_env.SETTLE_JOINT_VEL_WEIGHT * flip_env.SETTLE_CHARGE_FACTOR)
+        assert cfg.rewards["calm_home"].weight == jumpspin_env.SETTLE_HOME_WEIGHT
+    # The observations are untouched, so a checkpoint from before resumes.
+    critic = tasks.load_env_cfg("jumper.power_jumpspin").observations["critic"].terms
+    assert set(cfg.observations["critic"].terms) == set(critic)
+
+
+def test_the_full_turn_is_not_asked_to() -> None:
+    """`jumper.power_jumpspin` ships nothing; its runs trained without these."""
+    import tasks
+
+    cfg = tasks.load_env_cfg("jumper.power_jumpspin")
+    assert "back_home" in cfg.terminations
+    assert not set(SETTLE_TERMS) & set(cfg.rewards)
+
+
+def test_the_gate_counts_from_the_jump_being_over() -> None:
+    import torch
+
+    from tasks.jumper.power_jumpspin.mdp.calm import settle_gate
+
+    dt = 0.005
+    steps = torch.tensor([0.0, 39.0, 40.0, 70.0, 100.0, 400.0])
+    env = SimpleNamespace(step_dt=dt, command_manager=SimpleNamespace(
+        get_term=lambda name: SimpleNamespace(settle_steps=steps)))
+    g = settle_gate(env, "jump", start_s=0.2, full_s=0.5)
+    assert torch.allclose(g, torch.tensor([0.0, 0.0, 0.0, 0.5, 1.0, 1.0]))
+    with pytest.raises(ValueError):
+        settle_gate(env, "jump", start_s=0.5, full_s=0.5)
+
+
+def test_a_spawn_that_could_not_jump_is_never_settling() -> None:
+    import torch
+
+    from tasks.jumper.power_jumpspin.mdp.commands import RotationJumpCommand
+
+    #           landed  could  past the span
+    cases = [(True, True, False), (True, False, True), (False, True, True),
+             (False, True, False), (False, False, True), (False, False, False)]
+    landed, could, past = (torch.tensor(c) for c in zip(*cases))
+    cmd = SimpleNamespace(landed=landed, could_jump=could,
+                          time_since_go=torch.where(past, 2.0, 0.5),
+                          reference=SimpleNamespace(span=1.17))
+    got = RotationJumpCommand.settling.fget(cmd)
+    assert got.tolist() == [True, True, True, False, False, False]
+
+
+def test_settle_steps_count_without_a_jump() -> None:
+    """A robot held at HOME that never jumps is charged once the recording's span
+    has run out, as one that landed is from its landing."""
+    from mjlab.sim import get_simulation_cls, set_simulation_cls
+    from mjrl.backend import native_sim, select
+    from mjrl.backend.resolve import resolve
+
+    saved_cls = get_simulation_cls()
+    saved_nthread = native_sim._DEFAULT_NTHREAD
+    n = 2
+    res = resolve(backend="native", device="cpu", num_envs=n)
+    select.use_backend(res)
+    try:
+        _stand(n, res)
+    finally:
+        set_simulation_cls(saved_cls)
+        native_sim._DEFAULT_NTHREAD = saved_nthread
+
+
+def _stand(n: int, res) -> None:
+    import torch
+    from mjlab.envs import ManagerBasedRlEnv
+
+    import tasks
+
+    cfg = tasks.load_env_cfg("jumper.power_jumpspin720", play=True)
+    cfg.scene.num_envs = n
+    cfg.sim.device = res.device
+    env = ManagerBasedRlEnv(cfg, device=res.device)
+    try:
+        env.reset()
+        cmd = env.command_manager.get_term("jump")
+        span = cmd.reference.span
+        go_s = float(cmd.go_step[0]) * env.step_dt
+        zero = torch.zeros(n, env.action_manager.total_action_dim)
+        for _ in range(round((go_s + span + 0.1) / env.step_dt)):
+            env.step(zero)
+        assert not bool(cmd.landed.any())
+        assert bool(cmd.could_jump.all())
+        assert bool(cmd.settling.all())
+        assert bool((cmd.settle_steps > 0).all())
+        assert bool((cmd.settle_steps <= round(0.1 / env.step_dt) + 1).all())
+    finally:
+        env.close()
