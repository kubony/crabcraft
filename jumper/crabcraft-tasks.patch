@@ -0,0 +1,43 @@
+"""jumper.skill_powerdown -- a robot powering down, a keyframed reference learned by imitation.
+
+A one-shot move on the dance machinery, as the gestures are: the environment is
+`tasks/jumper/common/dance/env.py`, and what this directory adds is the clip and
+the numbers.
+
+## The clip
+
+`media/powerdown.npz`, written by `tools/author_skill_clips.py`, whose docstring has how
+the clip is made and checked; `docs/CRABCRAFT_SKILLS.md` has the numbers it passed
+with. It replaces `death`, one of the hand keyframes "World of Crabcraft" played
+where every other move is a rollout of a trained policy.
+
+A stutter as the power fails, then the walking legs give way one at a time --
+each foot slips 40 mm out, lifted and set down rather than slid -- and the
+shell settles onto the floor on its servo housings, the base origin 39 mm up.
+The claws go limp and are set down ahead and out with the pincers fallen open.
+Held from 2.05 to 3.20 s. Then the claws come back, the body rises, the feet
+step back in two diagonal pairs, and it stands. From the `HOME` footprint the
+shell cannot reach the floor: the knees meet their stops 45 mm down with the
+shell still 25 mm above it.
+
+The clip begins at `HOME` and ends with a lead-out back to it and half a second
+standing there, 5.68 s in all, so it starts and ends where the walking policy
+stands. The game plays a window of it: collapse from 0.30 s, down 1.60 s, settled
+2.05 to 3.20 s, rising 3.60 s, back by 4.76 s.
+
+There is no music, and nothing to export a performance video with: export with
+`--no-video`.
+"""
+
+from __future__ import annotations
+
+from ...registry import register
+from ..common.assets import JUMPER_ASSETS
+
+register(
+    id="jumper.skill_powerdown",
+    assets=JUMPER_ASSETS,
+    description="jumper hexapod imitating crabcraft's power-down, its death; the clip is "
+                "committed in tasks/jumper/skill_powerdown/media/",
+    tags=("imitation", "jumper", "skill", "flat"),
+)
diff --git a/tasks/jumper/skill_powerdown/env_cfg.py b/tasks/jumper/skill_powerdown/env_cfg.py
new file mode 100644
index 0000000..a538d24
--- /dev/null
+++ b/tasks/jumper/skill_powerdown/env_cfg.py
@@ -0,0 +1,127 @@
+"""Environment config for jumper.skill_powerdown: a robot powering down, `media/powerdown.npz`.
+
+The environment is `tasks/jumper/common/dance/env.py`; this file holds every
+number. Where a number follows a rule `jumper.dance` wrote down for its own clip,
+the rule is applied to this clip's measurements and the result is quoted -- read
+`tasks/jumper/dance/env_cfg.py` for the reasoning behind each rule.
+
+## This clip, measured
+
+At the 50 Hz control rate, after conversion (5.68 s, lead-out and hold included):
+per-joint position std 0.193 rad at the median and 0.318 at the most active, RMS
+amplitude 0.196 rad; joint velocity RMS 0.908 rad/s, per-joint std 0.629 at the
+median and 1.526 at the most active, peaking at 12.3 rad/s; the base between
+39 and 106 mm; tilt at most 3.2 degrees.
+
+**The reward weights are starting points**, as they are for jumper.dance: no policy
+has been trained on this clip in this repository yet.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from mjlab.envs import ManagerBasedRlEnvCfg
+
+from ..common.dance.env import dance_env_cfg
+
+#: This task's material, written by `tools/author_skill_clips.py`.
+MEDIA = Path(__file__).resolve().parent / "media"
+
+#: Episode length, seconds. Half the 5.68 s clip, jumper.dance_maze's rule for a
+#: short clip: the command teleports the robot back onto the reference wherever an
+#: episode runs off the end, and at half the clip an episode sampled in its first
+#: half runs clean.
+EPISODE_S = 2.84
+
+
+def env_cfg(asset: Path | None = None, play: bool = False) -> ManagerBasedRlEnvCfg:
+    """Build this task's environment config. See `jumper.dance`'s for the arguments."""
+    return dance_env_cfg(
+        media=MEDIA,
+        asset=asset,
+        play=play,
+        episode_s=EPISODE_S,
+        # ── Reference-state initialisation ────────────────────────────────
+        # jumper.dance's: fractions of this robot (10 mm is a tenth of its
+        # standing height), not of the clip, so they carry over unchanged.
+        rsi_pose_range={
+            "x": (-0.01, 0.01), "y": (-0.01, 0.01), "z": (-0.005, 0.005),
+            "roll": (-0.05, 0.05), "pitch": (-0.05, 0.05), "yaw": (-0.05, 0.05),
+        },
+        rsi_velocity_range={
+            "x": (-0.1, 0.1), "y": (-0.1, 0.1), "z": (-0.05, 0.05),
+            "roll": (-0.2, 0.2), "pitch": (-0.2, 0.2), "yaw": (-0.2, 0.2),
+        },
+        rsi_joint_range=(-0.05, 0.05),
+        # ── Observation noise ─────────────────────────────────────────────
+        # The tracking skeleton's, as jumper.dance has them; not measured.
+        joint_pos_noise=0.01,
+        joint_vel_noise=0.5,
+        # ── Rewards ───────────────────────────────────────────────────────
+        # Positive budget 6.5 a step, as jumper.dance: mjlab's six tracking
+        # terms unchanged (5.0) plus the two joint-space terms below (1.5).
+        #
+        # Joint position: jumper.dance's rule is a std at 0.44 of the clip's
+        # RMS amplitude. Here: 0.44 x 0.196 -> 0.09. Standing still through
+        # the whole clip scores 0.200, far above the dances' 0.006, and that
+        # is the clip, not the rule: 0.90 of its 5.68 s are the way back to
+        # HOME and the hold there, where standing still *is* tracking. Over
+        # the move alone, 4.78 s, standing still scores 0.075.
+        joint_pos_std=0.09,
+        joint_pos_weight=1.0,
+        # Joint velocity: two thirds of the clip's velocity RMS. Here: 0.908
+        # -> 0.61, and over the moving half of the clip standing still scores
+        # 0.176. Half the position weight, so when they disagree the pose
+        # wins.
+        joint_vel_std=0.61,
+        joint_vel_weight=0.5,
+        # Smoothness: -0.1 is calibrated at this action scale (0.25) and the
+        # second difference at half of it -- properties of the robot and the
+        # action space, not of the clip.
+        action_rate_weight=-0.1,
+        action_acc_weight=-0.05,
+        # Power: 22 joints at ~0.25 N*m and this clip's ~0.91 rad/s is ~5.0 W,
+        # so -0.02 is about -0.10 a step, 1.5% of the budget -- jumper.dance's
+        # weight.
+        power_weight=-0.02,
+        # Torque above the continuous rating: anchored to the servo, not the
+        # clip -- one joint at the plateau costs 0.6, 9% of the budget.
+        torque_headroom_weight=-2.0,
+        # Joint limits. The reference stays inside the soft joint limits but
+        # for one joint: `RF_J3_joint`, the right wrist, is 10 mrad past its
+        # soft limit for a few rows around 1.76 s, while the limp claw is
+        # carried: 0.1 a step at this weight, for those rows.
+        joint_limit_weight=-10.0,
+        # Leg-on-leg contact above 1.0 N, ~8% of the robot's worst-case push.
+        self_collision_weight=-1.0,
+        self_collision_force=1.0,
+        # ── Terminations ──────────────────────────────────────────────────
+        # Root height: **not jumper.dance's 40 mm, by jumper.dance's rule.**
+        # The rule is a threshold that exceeds the clip's whole vertical band,
+        # so that it cannot fire on a policy merely tracking badly, and this
+        # clip's band is 39-106 mm, 67 mm. 80 mm is the band and a centimetre,
+        # rounded up to 5 mm, as jumper.gesture_salute's 60 is its 50 mm band
+        # and one.
+        anchor_height_error=0.08,
+        # 1 - cos(tilt) = 0.3 is 45.6 degrees, "has fallen over"; the clip
+        # leans 3.2.
+        anchor_tilt_error=0.3,
+        # A support foot 50 mm out vertically is half the standing height.
+        #
+        # The shell rests on the floor in this clip on purpose, and nothing
+        # here has to make an exception for it: the tracking skeleton has no
+        # contact termination, only these three errors against the reference,
+        # and the reference is itself on the floor there. What the deployment
+        # adds is the controller's tilt fallback at 50 degrees, absolute; this
+        # clip leans at most 3.2.
+        support_foot_error=0.05,
+        # ── Disturbance ───────────────────────────────────────────────────
+        # jumper.dance's: gentler and rarer than mjlab's, sized to a 2 kg
+        # robot.
+        push_interval_s=(3.0, 8.0),
+        push_velocity_range={
+            "x": (-0.1, 0.1), "y": (-0.1, 0.1), "z": (-0.05, 0.05),
+            "roll": (-0.2, 0.2), "pitch": (-0.2, 0.2), "yaw": (-0.2, 0.2),
+        },
+    )
