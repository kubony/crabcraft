+"""jumper.power_spin -- an in-place yaw spin, as fast as the robot can turn.
+
+The crab's answer to a breaker's windmill or turtle spin: the body turns about
+its own vertical axis while the legs patter and push, for as long as the episode
+lasts. Reward-driven, no recording: the policy is paid for its yaw rate,
+counter-clockwise seen from above, and charged for leaving the spot, for tilting
+and for touching the ground with anything that is not a foot. See `env_cfg.py`
+for the design and `docs/CRABCRAFT_POWER.md` for what it reached.
+"""
+
+from __future__ import annotations
+
+from ...registry import register
+from ..common.assets import JUMPER_ASSETS
+
+register(
+    id="jumper.power_spin",
+    assets=JUMPER_ASSETS,
+    description=(
+        "jumper hexapod spinning in place about its vertical axis as fast as it can "
+        "(reward-driven, no recording)"
+    ),
+    tags=("jumper", "power", "spin", "flat"),
+)
diff --git a/tasks/jumper/power_spin/env_cfg.py b/tasks/jumper/power_spin/env_cfg.py
new file mode 100644
index 0000000..2107e04
--- /dev/null
+++ b/tasks/jumper/power_spin/env_cfg.py
@@ -0,0 +1,304 @@
+"""jumper.power_spin -- spin in place about the vertical axis, as fast as possible.
+
+## What it is trained to do
+
+Every episode starts at HOME, standing still, facing a random way. From there
+the policy is paid for the base's yaw rate (`mdp/rewards.py::spin_rate`,
+counter-clockwise seen from above, linear and uncapped in practice) and for
+staying upright; it is charged for the base leaving the spot it spawned on, for
+any part that is not a foot touching the ground, for legs knocking into each
+other, for joint limits and for chattering targets. There is no command and no
+clock: one behaviour, spin up and keep spinning.
+
+**Counter-clockwise only, and symmetry off.** A left-right mirror turns a
+counter-clockwise spin into a clockwise one, so the mirror augmentation the
+walking tasks use would ask the policy for both at once from the same state,
+and a mirror-symmetric policy cannot leave the symmetric HOME stance in either
+direction. A clockwise spin would be this policy mirrored; it is not trained here.
+
+## On the feet, not on the shell
+
+`illegal_contact` charges every step any part that is not a foot -- a calf, a
+palm, the shell -- touches the ground, at the jumps' weight, so that the spin is
+asked of the feet. Those parts are hard plastic and aluminium, not the silicone
+tips, and they are not meant to carry the robot.
+
+**They are not frictionless against the floor**, whatever their condim 1 in
+`common/constants.py` suggests. Their priority equals the plane's, so MuJoCo
+combines the pair: the larger condim and the larger friction, the plane's 3 and
+1.0. Measured on `pw-spin-a`'s `model_399` (native:cpu, DR off): every calf and
+palm contact with the ground was condim 3 at friction 1.0. A calf on a real floor
+grips less than that, so whatever load a policy puts through its calves is grip
+the robot may not have.
+
+The feet are condim 3, so a planted foot pivots for free -- a real silicone tip
+resists that twist a little. That makes a foot-borne spin slightly easier here
+than on the robot; how much is not measured.
+
+## Kept from jumper.ref_free_jump, and why
+
+200 Hz control, kp=20, absolute targets around HOME at an action scale of 0.5,
+and the strided five-frame history. A spin is fast leg work: at 200 Hz a 5 Hz
+leg cycle is 40 control steps. With kd=0.5, a joint moving at the servo's
+30.7 rad/s corner speed takes 15 N*m of damping that only a target 0.75 rad
+ahead of it can cancel at kp=20 -- reachable at scale 0.5 with an action of 1.5,
+which at the walking tasks' kp=10 and scale 0.25 would need an action of 6.
+The servo curve, the 1.7464 N*m plateau and the 0.3 s peak budget derating to
+1.2 N*m are the hardware's, untouched (`common/actuator.py`).
+
+## Terminations
+
+Time-out, and a tilt past 50 degrees -- the controller's own limit
+(`deploy/jumper.controller.toml` drops to `safe` there in every mode).
+
+## On the numbers below
+
+The physics and the hardware facts are measured or taken from where they are.
+The reward weights are first guesses, sized against the yaw rate: 1 per rad/s,
+so a spin at one turn a second earns 6.3 a second against the 1 standing
+upright earns. `docs/CRABCRAFT_POWER.md` records what each run did with them.
+"""
+
+from __future__ import annotations
+
+import math
+from pathlib import Path
+
+from mjlab.envs import ManagerBasedRlEnvCfg
+from mjlab.envs import mdp as envs_mdp
+from mjlab.envs.mdp.actions import JointPositionActionCfg
+from mjlab.managers import TerminationTermCfg
+from mjlab.managers.event_manager import EventTermCfg
+from mjlab.managers.observation_manager import ObservationTermCfg
+from mjlab.managers.reward_manager import RewardTermCfg
+from mjlab.managers.scene_entity_config import SceneEntityCfg
+from mjlab.sensor import ContactMatch, ContactSensorCfg
+from mjlab.tasks.velocity import mdp
+from mjlab.tasks.velocity.velocity_env_cfg import make_velocity_env_cfg
+from mjlab.utils.noise import UniformNoiseCfg as Unoise
+
+from ..common.constants import (
+    ACTUATOR_FORCE_NOISE,
+    EFFORT_LIMIT,
+    FOOT_GEOMS,
+    GAIT_JOINTS,
+    IMU_ANG_VEL_NOISE,
+    IMU_GRAVITY_NOISE,
+    JUMPER_FOOT_FRICTION_RANGE,
+    PUSH_VELOCITY_RANGE,
+    get_jumper_robot_cfg,
+)
+from ..common.mdp.observations import actuator_force
+from ..common.tof import tof_sensor
+from ..ref_free_jump import mdp as ref_free_mdp
+from ..ref_free_jump.env_cfg import _stride_history
+from . import mdp as spin_mdp
+
+# ── Physics and control: jumper.ref_free_jump's ────────────────────────────────
+_SIM_TIMESTEP = 0.0025
+_DECIMATION = 2
+_KP = 20.0
+ACTION_SCALE = 0.5
+
+# ── The objective ──────────────────────────────────────────────────────────────
+#: Per rad/s of counter-clockwise yaw rate. One turn a second pays 6.3 a second.
+SPIN_WEIGHT = 1.0
+
+#: Standing upright: exp(-|g_xy|^2 / sigma_sq), ref_free_jump's kernel and weight.
+UPRIGHT_WEIGHT = 1.0
+UPRIGHT_SIGMA_SQ = 0.10
+
+#: Horizontal distance from the spawn, charged as (d / DRIFT_SCALE)^2. 10 cm off
+#: the spot costs what standing upright pays; 20 cm, four times that. "In place"
+#: is the point, and a spin that wanders is a walk in a circle.
+DRIFT_WEIGHT = -1.0
+DRIFT_SCALE = 0.10
+
+#: Any part but a foot on the ground, and any two legs touching: the jumps'
+#: weights (`ref_free_jump/env_cfg.py` has the measurements behind them).
+ILLEGAL_CONTACT_WEIGHT = -5.0
+LEG_COLLISION_WEIGHT = -5.0
+
+#: Per squared radian a target moves in one control step: ref_free_jump's. A
+#: 5 Hz leg cycle of 0.5 rad on all 20 joints moves the targets by about 0.12
+#: rad^2 a step, 0.03 a second at this weight: it charges chatter, not pattering.
+ACTION_RATE_PER_RAD_SQ = -0.2304
+
+# ── Episode ────────────────────────────────────────────────────────────────────
+#: Long enough to spin up and to hold the spin for several seconds, so that what
+#: is measured over the last seconds is a sustained rate and not the spin-up.
+EPISODE_S = 6.0
+
+FELL_OVER_RAD = math.radians(50.0)
+
+_COLLISION_GEOMS = r".*_meshcol"
+
+
+def env_cfg(asset: Path | None = None, play: bool = False) -> ManagerBasedRlEnvCfg:
+    """In-place spin.
+
+    Args:
+        asset: path to the model XML, from `--model`. None uses the default jumper.xml.
+        play: replay mode -- observation noise and pushes off.
+    """
+    cfg = make_velocity_env_cfg()
+
+    # ── Sim ───────────────────────────────────────────────────────────────────
+    cfg.sim.mujoco.timestep = _SIM_TIMESTEP
+    cfg.decimation = _DECIMATION
+    cfg.sim.njmax = 512
+    cfg.sim.nconmax = 128
+    cfg.sim.mujoco.ccd_iterations = 50
+    cfg.sim.contact_sensor_maxmatch = 128
+
+    # ── Scene ─────────────────────────────────────────────────────────────────
+    assert cfg.scene.terrain is not None
+    cfg.scene.terrain.terrain_type = "plane"
+    cfg.scene.terrain.terrain_generator = None
+    robot = get_jumper_robot_cfg(effort_limit=EFFORT_LIMIT, asset=asset)
+    for actuator in robot.articulation.actuators:
+        actuator.stiffness = _KP
+    cfg.scene.entities = {"robot": robot}
+
+    cfg.scene.sensors = tuple(
+        s for s in (cfg.scene.sensors or ())
+        if s.name not in ("terrain_scan", "foot_height_scan")
+    ) + (
+        ContactSensorCfg(
+            name="feet_ground_contact",
+            primary=ContactMatch(mode="geom", pattern=FOOT_GEOMS, entity="robot"),
+            secondary=ContactMatch(mode="body", pattern="terrain"),
+            fields=("found", "force"),
+            reduce="netforce",
+            num_slots=1,
+            track_air_time=True,
+        ),
+        ContactSensorCfg(
+            name="self_collision",
+            primary=ContactMatch(mode="subtree", pattern="base_link", entity="robot"),
+            secondary=ContactMatch(mode="subtree", pattern="base_link", entity="robot"),
+            fields=("found", "force"),
+            reduce="none",
+            num_slots=1,
+            history_length=_DECIMATION,
+        ),
+        ContactSensorCfg(
+            name="body_ground_contact",
+            primary=ContactMatch(mode="geom", pattern=_COLLISION_GEOMS, entity="robot",
+                                 exclude=FOOT_GEOMS),
+            secondary=ContactMatch(mode="body", pattern="terrain"),
+            fields=("force",),
+            reduce="netforce",
+            num_slots=1,
+        ),
+    )
+
+    # ── Observations ──────────────────────────────────────────────────────────
+    for group in cfg.observations.values():
+        for name in ("command", "height_scan", "foot_height", "foot_air_time",
+                     "foot_contact", "foot_contact_forces"):
+            group.terms.pop(name, None)
+    # No state estimator on the robot: the actor gets no linear velocity.
+    del cfg.observations["actor"].terms["base_lin_vel"]
+
+    gait_cfg = SceneEntityCfg("robot", joint_names=list(GAIT_JOINTS))
+    for group in cfg.observations.values():
+        for name in ("joint_pos", "joint_vel"):
+            term = group.terms.get(name)
+            if term is not None:
+                term.params = dict(term.params or {}) | {"asset_cfg": gait_cfg}
+        if "base_ang_vel" in group.terms:
+            group.terms["base_ang_vel"].noise = Unoise(
+                n_min=-IMU_ANG_VEL_NOISE, n_max=IMU_ANG_VEL_NOISE
+            )
+        if "projected_gravity" in group.terms:
+            group.terms["projected_gravity"].noise = Unoise(
+                n_min=-IMU_GRAVITY_NOISE, n_max=IMU_GRAVITY_NOISE
+            )
+
+    force_cfg = SceneEntityCfg("robot", actuator_names=list(GAIT_JOINTS))
+    for group in cfg.observations.values():
+        group.terms["actuator_force"] = ObservationTermCfg(
+            func=actuator_force,
+            params={"asset_cfg": force_cfg},
+            noise=Unoise(n_min=-ACTUATOR_FORCE_NOISE, n_max=ACTUATOR_FORCE_NOISE),
+        )
+    cfg.observations["critic"].terms["base_offset"] = ObservationTermCfg(
+        func=spin_mdp.observations.base_offset, params={"scale": DRIFT_SCALE},
+    )
+
+    # ── Action: absolute targets around HOME ──────────────────────────────────
+    cfg.actions["joint_pos"] = JointPositionActionCfg(
+        entity_name="robot",
+        actuator_names=list(GAIT_JOINTS),
+        scale={j: ACTION_SCALE for j in GAIT_JOINTS},
+        use_default_offset=True,
+    )
+
+    cfg.commands = {}
+
+    # ── Rewards ───────────────────────────────────────────────────────────────
+    cfg.rewards = {
+        "spin_rate": RewardTermCfg(func=spin_mdp.rewards.spin_rate, weight=SPIN_WEIGHT),
+        "upright": RewardTermCfg(
+            func=ref_free_mdp.rewards.upright, weight=UPRIGHT_WEIGHT,
+            params={"sigma_sq": UPRIGHT_SIGMA_SQ},
+        ),
+        "horizontal_drift": RewardTermCfg(
+            func=ref_free_mdp.rewards.horizontal_drift, weight=DRIFT_WEIGHT,
+            params={"scale": DRIFT_SCALE},
+        ),
+        "illegal_contact": RewardTermCfg(
+            func=ref_free_mdp.rewards.illegal_contact, weight=ILLEGAL_CONTACT_WEIGHT,
+            params={"sensor_name": "body_ground_contact", "force_threshold": 1.0},
+        ),
+        "leg_collision": RewardTermCfg(
+            func=ref_free_mdp.rewards.leg_collision, weight=LEG_COLLISION_WEIGHT,
+            params={"sensor_name": "self_collision", "force_threshold": 1.0},
+        ),
+        "dof_pos_limits": RewardTermCfg(func=mdp.joint_pos_limits, weight=-1.0),
+        "action_rate_l2": RewardTermCfg(
+            func=mdp.action_rate_l2, weight=ACTION_RATE_PER_RAD_SQ * ACTION_SCALE**2
+        ),
+    }
+    cfg.curriculum = {}
+
+    # ── Terminations ──────────────────────────────────────────────────────────
+    cfg.terminations = {
+        "time_out": TerminationTermCfg(func=envs_mdp.time_out, time_out=True),
+        "fell_over": TerminationTermCfg(
+            func=mdp.bad_orientation, params={"limit_angle": FELL_OVER_RAD}
+        ),
+    }
+
+    # ── Events ────────────────────────────────────────────────────────────────
+    cfg.events["foot_friction"].params["asset_cfg"] = SceneEntityCfg(
+        "robot", geom_names=FOOT_GEOMS
+    )
+    cfg.events["foot_friction"].params["ranges"] = JUMPER_FOOT_FRICTION_RANGE
+    cfg.events["base_com"].params["asset_cfg"].body_names = ("base_link",)
+    cfg.events["push_robot"].params["velocity_range"].update(PUSH_VELOCITY_RANGE)
+    cfg.events.pop("reset_robot_joints", None)
+    # HOME at the env origin, standing still, facing a random way.
+    cfg.events["reset_base"].params["pose_range"] = {"yaw": (-math.pi, math.pi)}
+    cfg.events = {
+        "reset_to_default": EventTermCfg(func=envs_mdp.reset_scene_to_default, mode="reset"),
+        **cfg.events,
+    }
+
+    # ── Episode and viewer ────────────────────────────────────────────────────
+    cfg.episode_length_s = EPISODE_S
+    cfg.viewer.body_name = "base_link"
+    cfg.viewer.distance = 0.9
+    cfg.viewer.elevation = -25.0
+
+    if play:
+        cfg.observations["actor"].enable_corruption = False
+        cfg.events.pop("push_robot", None)
+        cfg.scene.sensors = (cfg.scene.sensors or ()) + (tof_sensor(),)
+
+    _stride_history(cfg)
+    return cfg
+
+
+__all__ = ["env_cfg"]
