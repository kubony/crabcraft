index 0000000..f824a71
--- /dev/null
+++ b/tasks/jumper/power_backflip/mdp/rewards.py
@@ -0,0 +1,99 @@
+"""The back flip's own reward term: turn that did not make a flip is given back.
+
+`flight_turn_rate` pays the nose-up rate during the own flight whatever happens
+next, which is what let the probe find a flip at all (`env_cfg.py`). From the
+controller's handover it was farmed two ways, both measured from the handover
+(native:cpu, the training's randomisation, 32 environments):
+
+- **turn, then crash.** `pw-flip-ho` (resumed from `pw-flip-T`'s `model_2498` on
+  the handover start, 2000 iterations, 4096 envs, H100, warp:cuda) ended paying
+  `flight_turn_rate` 40.8 a second against `pw-flip-T`'s 24.1 and `landed_turn`
+  0.93 against 3.54, with 2.17 `tipped_on_feet` and 0.79 `chassis_crash`
+  terminations per logging window against none. Its mean policy did not leave
+  the ground from the handover.
+- **turn in hops that are not the jump.** A flight counts as the episode's jump
+  only once it lifts the robot's lowest point `min_rise` (1 cm), but the rate is
+  paid in every own flight before that. With a crash charged for,
+  `pw-flip-hoc`'s `model_2950` (450 iterations on) took off 5 to 64 times an
+  episode in hops under 1 cm, rocking nose-up while its feet were off the floor,
+  and was paid 25 to 167 for it -- more than a landed flip's 94 -- without ever
+  jumping.
+
+`turn_clawback` charges back what `flight_turn_rate` paid for a flight on the
+step that flight is seen to end without having become the jump, and everything
+it paid that episode on the step a failure terminates it. So the in-air rate
+stays paid only for the one flight that is the jump, and only while the robot
+has not crashed.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import torch
+
+from ...power_jumpspin.mdp import rewards as turn_rewards
+
+if TYPE_CHECKING:
+    from mjlab.envs import ManagerBasedRlEnv
+    from mjlab.managers.reward_manager import RewardTermCfg
+
+
+class turn_clawback:
+    """What `flight_turn_rate` has paid and must give back, in rad, divided by the
+    step so that the manager's `weight * dt` makes it exactly what was paid.
+
+    Give it `flight_turn_rate`'s weight, negated, and the same `cap` and
+    `max_rate`. Two charges:
+
+    - a flight that has ended (the command's `in_flight` was set at the last
+      reward and is not now) and did not become the jump (`landed` is still
+      false): what that flight was paid;
+    - with `charge_crash`, a failure termination this step
+      (`termination_manager.terminated`, which excludes the time-outs `time_out`
+      and `back_home`; terminations are computed before rewards in a step):
+      everything still kept this episode.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRlEnv) -> None:
+        n = env.num_envs
+        self.flight_paid = torch.zeros(n, device=env.device)
+        self.kept = torch.zeros(n, device=env.device)
+        self.was_flying = torch.zeros(n, dtype=torch.bool, device=env.device)
+
+    def reset(self, env_ids: torch.Tensor | slice | None = None) -> None:
+        ids = slice(None) if env_ids is None else env_ids
+        self.flight_paid[ids] = 0.0
+        self.kept[ids] = 0.0
+        self.was_flying[ids] = False
+
+    def __call__(
+        self,
+        env: ManagerBasedRlEnv,
+        command_name: str = "jump",
+        max_rate: float = 60.0,
+        cap: float | None = None,
+        charge_crash: bool = True,
+    ) -> torch.Tensor:
+        cmd = env.command_manager.get_term(command_name)
+        flying = cmd.in_flight
+        hop = self.was_flying & ~flying & ~cmd.landed
+        charge = torch.where(hop, self.flight_paid, torch.zeros_like(self.flight_paid))
+        self.kept -= charge
+        started = flying & ~self.was_flying
+        self.flight_paid.masked_fill_(started | ~flying, 0.0)
+
+        pay = turn_rewards.flight_turn_rate(env, command_name, max_rate, cap) * env.step_dt
+        self.flight_paid += pay
+        self.kept += pay
+        self.was_flying.copy_(flying)
+
+        if not charge_crash:
+            return charge / env.step_dt
+        crashed = env.termination_manager.terminated
+        charge = charge + torch.where(crashed, self.kept, torch.zeros_like(self.kept))
+        self.kept.masked_fill_(crashed, 0.0)
+        return charge / env.step_dt
+
+
+__all__ = ["turn_clawback"]
diff --git a/tasks/jumper/power_backflip/mdp/terminations.py b/tasks/jumper/power_backflip/mdp/terminations.py
new file mode 100644
index 0000000..220d9f0
--- /dev/null
+++ b/tasks/jumper/power_backflip/mdp/terminations.py
@@ -0,0 +1,44 @@
+"""How a back-flip attempt ends early, in place of the 50 degree tilt limit.
+
+A flip passes through every tilt, so the tilt limit the other jumps use would
+end every attempt a fifth of the way round. In its place:
+
+- `chassis_crash`: the base, the shell, or a sensor housing on the ground --
+  the attempt landed on its back or its side;
+- `tipped_on_feet`: past `limit_angle` of tilt with a foot on the ground -- a
+  landing on the rear feet with the body still inverted, or a roll-over on the
+  legs. In the air the tilt is unlimited.
+"""
+
+from __future__ import annotations
+
+import torch
+from mjlab.entity import Entity
+
+
+def chassis_crash(
+    env, sensor_name: str = "chassis_ground_contact", force_threshold: float = 1.0
+) -> torch.Tensor:
+    """Any chassis geom pressing on the ground harder than `force_threshold`."""
+    f = env.scene[sensor_name].data.force
+    assert f is not None
+    return (f.norm(dim=-1) > force_threshold).any(dim=1)
+
+
+def tipped_on_feet(
+    env,
+    limit_angle: float,
+    sensor_name: str = "feet_ground_contact",
+    force_threshold: float = 1.0,
+) -> torch.Tensor:
+    """Tilted past `limit_angle` (radians) while any foot touches the ground."""
+    robot: Entity = env.scene["robot"]
+    g = robot.data.projected_gravity_b
+    tilt = torch.acos(torch.clamp(-g[:, 2], -1.0, 1.0))
+    f = env.scene[sensor_name].data.force
+    assert f is not None
+    grounded = (f.norm(dim=-1) > force_threshold).any(dim=1)
+    return (tilt > limit_angle) & grounded
+
+
+__all__ = ["chassis_crash", "tipped_on_feet"]
