index 0000000..81e9966
--- /dev/null
+++ b/tasks/jumper/power_jumpspin/mdp/calm.py
@@ -0,0 +1,157 @@
+"""Settling after the landing, for the two shipped jumps.
+
+What the jumps were paid for ended at the landing: the turn and the apex are
+latched there and paid every step after it whatever the body does, and the
+only terms that spoke for keeping still were `home_pose` (1 a second at most)
+and `action_rate_l2`. The back flip, `pw-flip-brc`'s `model_3997`, landed and then
+shook: from 0.5 s after its touchdown to 4 s (native:cpu, DR off, handed over
+after 0.3 s at HOME), its joints moved at 2.98 rad/s RMS, the base rocked at 41
+deg/s RMS in roll and pitch, and the targets alternated at 23 Hz with some gait
+joint at the torque plateau in 90% of the steps -- the whole three seconds,
+never decaying. `action_rate_l2` charged that 0.11 a second, against the 16 a
+second the latched turn and apex were paying. The 720, `pw-jspin720-ho`'s
+`model_5996`, swayed less (1.21 rad/s, 18 deg/s), but it had never been asked to
+stay anywhere: `back_home` ended its episodes 0.1 s after it first stood at HOME.
+
+These terms ask for rest once the episode is settling (`commands.py`'s
+`settling`): its own jump has landed, or it could have made one and the
+recording's span has run out. Each is multiplied by `settle_gate`, 0 until
+`start_s` after that and 1 from `full_s`, linear between. The landing itself is
+left alone: catching a flip that touches down 30 degrees nose-up takes the
+plateau for a moment, and that is not what is charged.
+
+Four charge motion, linearly -- joint speed, action rate, actuator force, roll
+and pitch rate -- and one pays for being at HOME.
+
+**Who is charged.** A charge after the landing is something a fall ends. Where
+the episode is being paid for its jump -- the latched turn and apex, 16 a second
+for the flip -- standing is still worth more than falling. A reference-state
+spawn past the bottom of the crouch can make no jump of its own and is paid
+nothing for one. Gated on the span running out as well, such spawns were
+charged for standing and nothing else, and learnt to fall: in the training's
+own configuration (64 environments, 8 s, the policy's own noise),
+`cm-720-4x`'s `model_8494` fell over in 67 of 159 episode ends against
+`pw-jspin720-ho`'s 4 of 128, every fall from such a spawn about 1.0 s after the
+go -- just before the charges would have begun. They are not charged now. An
+episode that could have jumped and did not still is, after the span: not
+jumping does not dodge the charges.
+
+**Why not pay for rest instead.** `exp(-x / scale)` per term never charges,
+which removes the reason to fall for everyone. The 720 came to rest on it, but
+the flip's action noise grew under it, 0.15 to 0.76 in 2400 iterations from
+`pw-flip-brc`, and with it its shaking: once the noise alone puts every term
+near 0, the exponential stops pulling, and nothing held the noise down. Charged
+linearly, the noise costs in proportion to its square, and every run here
+brought its noise down.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import torch
+from mjlab.entity import Entity
+from mjlab.managers.scene_entity_config import SceneEntityCfg
+
+if TYPE_CHECKING:
+    from mjlab.envs import ManagerBasedRlEnv
+
+
+def settle_gate(
+    env: ManagerBasedRlEnv, command_name: str, start_s: float, full_s: float
+) -> torch.Tensor:
+    """0 until `start_s` after the episode began settling, 1 from `full_s`, linear
+    between (`commands.py`'s `settle_steps`). Always 0 for a spawn that could
+    never jump."""
+    if not 0.0 <= start_s < full_s:
+        raise ValueError(f"need 0 <= start_s < full_s, got {start_s} and {full_s}")
+    cmd = env.command_manager.get_term(command_name)
+    t = cmd.settle_steps * env.step_dt
+    return ((t - start_s) / (full_s - start_s)).clamp(0.0, 1.0)
+
+
+def calm_joint_vel(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg,
+    command_name: str = "jump",
+    start_s: float = 0.2,
+    full_s: float = 0.5,
+) -> torch.Tensor:
+    """Summed squared speed of `asset_cfg`'s joints, (rad/s)^2, gated.
+
+    `asset_cfg` has no default, for the reason `ref_free_jump`'s `home_pose`
+    gives: only a `SceneEntityCfg` in the params is resolved."""
+    robot: Entity = env.scene[asset_cfg.name]
+    qd = robot.data.joint_vel[:, asset_cfg.joint_ids]
+    return (qd**2).sum(dim=1) * settle_gate(env, command_name, start_s, full_s)
+
+
+def calm_action_rate(
+    env: ManagerBasedRlEnv,
+    command_name: str = "jump",
+    start_s: float = 0.2,
+    full_s: float = 0.5,
+) -> torch.Tensor:
+    """mjlab's `action_rate_l2` -- the summed squared change of the raw action --
+    gated: alternating targets, which the joint's inertia hides from its angle
+    and the servo does not."""
+    am = env.action_manager
+    rate = ((am.action - am.prev_action) ** 2).sum(dim=1)
+    return rate * settle_gate(env, command_name, start_s, full_s)
+
+
+def calm_torque(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg,
+    command_name: str = "jump",
+    start_s: float = 0.2,
+    full_s: float = 0.5,
+) -> torch.Tensor:
+    """Summed squared actuator force of `asset_cfg`'s actuators, (N*m)^2, gated.
+    Standing at HOME holds the body on 0.14 to 0.20 N*m on average; the flip's
+    shaking sat at the 1.746 N*m plateau."""
+    robot: Entity = env.scene[asset_cfg.name]
+    tau = robot.data.actuator_force[:, asset_cfg.actuator_ids]
+    return (tau**2).sum(dim=1) * settle_gate(env, command_name, start_s, full_s)
+
+
+def calm_base_ang_vel(
+    env: ManagerBasedRlEnv,
+    command_name: str = "jump",
+    start_s: float = 0.2,
+    full_s: float = 0.5,
+) -> torch.Tensor:
+    """Squared roll and pitch rate of the base, body frame, (rad/s)^2, gated: the
+    rocking the IMU sees. Yaw is left out -- the 720 may still be turning on its
+    feet as it comes down, and that is not shaking."""
+    robot: Entity = env.scene["robot"]
+    w = robot.data.root_link_ang_vel_b[:, :2]
+    return (w**2).sum(dim=1) * settle_gate(env, command_name, start_s, full_s)
+
+
+def calm_home(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg,
+    command_name: str = "jump",
+    sigma_sq: float = 0.05,
+    start_s: float = 0.2,
+    full_s: float = 0.5,
+) -> torch.Tensor:
+    """exp(-e / sigma_sq), e the mean squared distance of `asset_cfg`'s joints from
+    HOME, gated: `ref_free_jump`'s `home_pose` once more, for the rest after the
+    landing. HOME is where the controller hands over from and back to."""
+    robot: Entity = env.scene[asset_cfg.name]
+    q = robot.data.joint_pos[:, asset_cfg.joint_ids]
+    home = robot.data.default_joint_pos[:, asset_cfg.joint_ids]
+    e = ((q - home) ** 2).mean(dim=1)
+    return torch.exp(-e / sigma_sq) * settle_gate(env, command_name, start_s, full_s)
+
+
+__all__ = [
+    "calm_action_rate",
+    "calm_base_ang_vel",
+    "calm_home",
+    "calm_joint_vel",
+    "calm_torque",
+    "settle_gate",
+]
diff --git a/tasks/jumper/power_jumpspin/mdp/commands.py b/tasks/jumper/power_jumpspin/mdp/commands.py
new file mode 100644
index 0000000..13a9750
--- /dev/null
+++ b/tasks/jumper/power_jumpspin/mdp/commands.py
@@ -0,0 +1,148 @@
+"""The reference-free jump's command, counting how far the body turns.
+
+`jumper.ref_free_jump`'s `RefFreeJumpCommand` already decides whose flight a
+flight is -- one jump per episode, pushed from no later than the bottom of the
+crouch, a lowest point risen `min_rise` above HOME -- and is used as it is. What
+this adds is the rotation, about one axis:
+
+- `yaw`: the base's world-frame yaw rate, counter-clockwise seen from above
+  (`jumper.power_jumpspin`);
+- `pitch`: the base's body-frame pitch rate, **nose up positive**, so that a
+  back flip counts up (`jumper.power_backflip`). A positive rotation about the
+  body's y axis (left) takes the nose down, so the sign is flipped.
+
+Three running totals, each integrated per control step with the trapezoid rule
+from the rate at either end of the step:
+
+- `turn`: since the episode began;
+- `flight_turn`: since the own flight took off, frozen when it touches down;
+- `landed_turn`: `flight_turn` at the touchdown that made the jump the
+  episode's jump -- what the jump achieved in the air, latched.
+
+**Integrated, not read off the orientation.** A yaw angle taken from the
+quaternion is unwrapped easily at 200 Hz, but a pitch angle is not an angle a
+flip passes through continuously -- at 90 degrees nose-up the Euler
+decomposition swaps branches. The rate is what the IMU measures in any case.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Literal
+
+import torch
+
+from ...ref_free_jump.mdp.commands import RefFreeJumpCommand, RefFreeJumpCommandCfg
+
+if TYPE_CHECKING:
+    from mjlab.envs import ManagerBasedRlEnv
+
+
+@dataclass(kw_only=True)
+class RotationJumpCommandCfg(RefFreeJumpCommandCfg):
+    axis: Literal["yaw", "pitch"]
+    """Which rotation is counted; see the module docstring for the signs."""
+
+    reset_share: float = 0.0
+    """Share of the held HOME spawns (`mdp/handover.py`) whose go is put back at
+    the reset itself: mjlab's reset, the start the jumps first trained from. 0
+    everywhere but in `jumper.power_backflip`'s bridge, a curriculum that brings
+    it down to 0 (`power_backflip/mdp/curriculum.py`)."""
+
+    def __post_init__(self):
+        if self.axis not in ("yaw", "pitch"):
+            raise ValueError(f"axis must be 'yaw' or 'pitch', got {self.axis!r}")
+        self.class_type = RotationJumpCommand
+
+    def build(self, env: ManagerBasedRlEnv) -> RotationJumpCommand:
+        return RotationJumpCommand(self, env)
+
+
+class RotationJumpCommand(RefFreeJumpCommand):
+    cfg: RotationJumpCommandCfg
+
+    def __init__(self, cfg: RotationJumpCommandCfg, env: ManagerBasedRlEnv):
+        super().__init__(cfg, env)
+        n = self.num_envs
+        self.turn = torch.zeros(n, device=self.device)
+        self.flight_turn = torch.zeros(n, device=self.device)
+        self.landed_turn = torch.zeros(n, device=self.device)
+        #: The largest `turn` has been this episode.
+        self.peak_turn = torch.zeros(n, device=self.device)
+        #: Whether the episode could make a jump of its own when it spawned: every
+        #: HOME spawn, and a reference-state spawn before the bottom of the crouch.
+        self.could_jump = torch.zeros(n, dtype=torch.bool, device=self.device)
+        #: Control steps since the episode's settling began (`settling`): what the
+        #: settling terms (`calm.py`) are gated on.
+        self.settle_steps = torch.zeros(n, device=self.device)
+        self._last_rate = torch.zeros(n, device=self.device)
+        self._landed_turn_metric = torch.zeros(n, device=self.device)
+        self.metrics["landed_turn_deg"] = self._landed_turn_metric
+
+    def rate(self) -> torch.Tensor:
+        """The counted rotation's rate now, rad/s."""
+        data = self.robot.data
+        if self.cfg.axis == "yaw":
+            return data.root_link_ang_vel_w[:, 2]
+        return -data.root_link_ang_vel_b[:, 1]
+
+    def _resample_command(self, env_ids: torch.Tensor) -> None:
+        super()._resample_command(env_ids)
+        if self.cfg.reset_share > 0.0:
+            held = self.go_step[env_ids] > 0.0
+            pick = torch.rand(len(env_ids), device=self.device) < self.cfg.reset_share
+            self.go_step[env_ids] = torch.where(
+                held & pick, torch.zeros_like(self.go_step[env_ids]), self.go_step[env_ids]
+            )
+        for t in (self.turn, self.flight_turn, self.landed_turn, self.peak_turn,
+                  self.settle_steps):
+            t[env_ids] = 0.0
+        self.could_jump[env_ids] = self.can_jump[env_ids]
+
+    def _update_metrics(self) -> None:
+        super()._update_metrics()
+        self._landed_turn_metric[:] = torch.rad2deg(self.landed_turn) * self.landed
+        self.metrics["landed_turn_deg"] = self._landed_turn_metric
+
+    def _update_command(self, env_ids: torch.Tensor | None = None) -> None:
+        if env_ids is not None:
+            super()._update_command(env_ids)
+            # Reset path: the spawn state was just written; start the trapezoid
+            # from its rate.
+            self._last_rate[env_ids] = self.rate()[env_ids]
+            return
+        # Whether the step that just ran was flown -- `in_flight` as the last
+        # update left it, before this one moves it on.
+        was_flying = self.in_flight.clone()
+        was_landed = self.landed.clone()
+        rate = self.rate()
+        step = 0.5 * (rate + self._last_rate) * self._env.step_dt
+        self._last_rate.copy_(rate)
+        self.turn.add_(step)
+        self.peak_turn.copy_(torch.maximum(self.peak_turn, self.turn))
+        self.flight_turn.add_(step * was_flying.float())
+
+        super()._update_command(env_ids)
+
+        took_off = self.in_flight & ~was_flying
+        self.flight_turn.masked_fill_(took_off, 0.0)
+        jumped = self.landed & ~was_landed
+        self.landed_turn.copy_(torch.where(jumped, self.flight_turn, self.landed_turn))
+        # Never turns false again within an episode: `landed` is latched and the
+        # time since the go only grows.
+        self.settle_steps.copy_(torch.where(self.settling, self.settle_steps + 1.0,
+                                            torch.zeros_like(self.settle_steps)))
+
+    @property
+    def settling(self) -> torch.Tensor:
+        """The episode is asked to come to rest: its own jump has landed, or it
+        could have made one and the recording's span has run out without it.
+
+        Not a spawn that could never jump -- a reference-state spawn past the
+        bottom of the crouch. It is paid nothing for a jump, so charged for
+        moving once the span ran out it had nothing to lose by falling, and
+        learnt to (`calm.py`)."""
+        return self.landed | (self.could_jump & (self.time_since_go > self.reference.span))
+
+
+__all__ = ["RotationJumpCommand", "RotationJumpCommandCfg"]
diff --git a/tasks/jumper/power_jumpspin/mdp/handover.py b/tasks/jumper/power_jumpspin/mdp/handover.py
new file mode 100644
index 0000000..191c997
--- /dev/null
+++ b/tasks/jumper/power_jumpspin/mdp/handover.py
@@ -0,0 +1,120 @@
+"""Episodes that begin the way the bundle's controller hands a mode over.
+
+A turning jump's actor sees no clock and no command, so whatever starts the jump
+has to be in what it observes. Until these terms existed, every episode began at
+mjlab's reset, whose first observation shows `joint_torque` at the servo's limit
+on 18 of the 20 joints, in all five frames of the history: the PD toward a
+target of zero before the first action, saturated by HOME's offsets. The jumps
+learnt to take off on that, and from a robot standing at HOME with its real
+torques -- which is what a controller switching into the mode hands over --
+they did not (`docs/CRABCRAFT_POWER.md`, "Under the controller").
+
+What the controller does on a switch (`deploy/crabcraft.controller.toml`, and
+measured through the bundle's own controller in crabcraft's `jumper_sim.Host`):
+its ramp slides the setpoint to the mode's HOME at its own PD and hands over
+once every joint is within `pose_reach_tol` (0.10 rad) of it -- 0.57 s after the
+switch from standing, the worst joint 0.099 rad off, the fastest 0.20 rad/s, the
+torques 0.39 N*m at most. The policy's first observation is that moment's frame
+in every slot of the history, its last action zero.
+
+These terms put the same moment at the start of a HOME spawn:
+
+- the spawn is HOME with every gait joint up to `HANDOVER_POSE_RANGE` off it
+  (`env_cfg.py`), a reset event ahead of the reference-state spawns, which
+  overwrite it for their share;
+- `HandoverJointPositionAction` holds the target at HOME -- the raw action zero,
+  in the manager's copy too, so the actor's `actions` and `action_rate_l2` read
+  zero -- until the jump command's go, which `env_cfg.py` delays by a random
+  hold: the robot settles under its own PD, with its own torques;
+- `handover_history`, a step event, empties every observation history at the go,
+  so the frame the policy first acts on fills all five slots, as the
+  controller's reset of the history does.
+
+The go was the episode's first step before (`ref_free_jump`'s `GO_DELAY_RANGE`
+is zero); the command's own bookkeeping already counts a takeoff only after the
+go, so nothing it pays changes meaning. A reference-state spawn has its go in
+the past and is not held.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+import torch
+from mjlab.envs.mdp.actions import JointPositionAction, JointPositionActionCfg
+
+if TYPE_CHECKING:
+    from mjlab.envs import ManagerBasedRlEnv
+
+
+def holding(env: ManagerBasedRlEnv, command_name: str) -> torch.Tensor:
+    """Environments whose go has not come yet, for the action about to be applied.
+
+    `episode_length_buf` is the step the action is applied at; the go is the
+    command's `go_step`, so an action is held while its step comes before it.
+    """
+    cmd = env.command_manager.get_term(command_name)
+    return env.episode_length_buf.float() < cmd.go_step
+
+
+@dataclass(kw_only=True)
+class HandoverJointPositionActionCfg(JointPositionActionCfg):
+    command_name: str = "jump"
+    """The jump command, whose go ends the hold."""
+
+    def build(self, env: ManagerBasedRlEnv) -> HandoverJointPositionAction:
+        return HandoverJointPositionAction(self, env)
+
+
+class HandoverJointPositionAction(JointPositionAction):
+    """An absolute joint target around HOME that holds HOME until the go.
+
+    The held action is zero in the action manager's buffer as well as here: the
+    actor's `actions` observation and `action_rate_l2` read that buffer, and on
+    the robot the policy's first observation shows a last action of zero. The
+    policy's own output for a held step is still what PPO stored; the step's
+    outcome does not depend on it.
+    """
+
+    cfg: HandoverJointPositionActionCfg
+
+    def process_actions(self, actions: torch.Tensor) -> None:
+        held = holding(self._env, self.cfg.command_name)
+        if bool(held.any()):
+            manager = self._env.action_manager
+            if manager.total_action_dim != self.action_dim:
+                raise RuntimeError(
+                    "the handover holds the whole action: this term must be the only one"
+                )
+            actions = torch.where(held[:, None], torch.zeros_like(actions), actions)
+            manager.action[held] = 0.0
+        super().process_actions(actions)
+
+
+def handover_history(env: ManagerBasedRlEnv, env_ids: torch.Tensor | None,
+                     command_name: str = "jump") -> None:
+    """Step event: at the go, empty every observation history of the environments
+    whose go it is, so that the observation computed at the end of this step --
+    the one the policy first acts on -- fills every frame with itself.
+
+    Runs after the step's `episode_length_buf` increment and before the
+    observation is computed, so the go is now when the step just counted reached
+    it and the one before had not.
+    """
+    del env_ids
+    cmd = env.command_manager.get_term(command_name)
+    k = env.episode_length_buf.float()
+    go = cmd.go_step
+    now = (go > 0.0) & (k >= go) & (k - 1.0 < go)
+    ids = now.nonzero(as_tuple=False).flatten()
+    if len(ids) > 0:
+        env.observation_manager.reset(ids)
+
+
+__all__ = [
+    "HandoverJointPositionAction",
+    "HandoverJointPositionActionCfg",
+    "handover_history",
+    "holding",
+]
diff --git a/tasks/jumper/power_jumpspin/mdp/observations.py b/tasks/jumper/power_jumpspin/mdp/observations.py
new file mode 100644
index 0000000..2b7c5ed
--- /dev/null
+++ b/tasks/jumper/power_jumpspin/mdp/observations.py
@@ -0,0 +1,37 @@
+"""Critic-only observation: the rotation bookkeeping the rewards are paid from.
+
+`landed_turn` is latched at a touchdown and paid for the rest of the episode;
+a value function that cannot see the latch is fitting noise, the argument
+`ref_free_jump/mdp/observations.py` makes for the apex.
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+
+
+def turn_state(
+    env, command_name: str = "jump", mirror_kind: str | None = None
+) -> torch.Tensor:
+    """(turn, flight_turn, landed_turn) in half turns, and the rate in rad/s / 10.
+
+    `mirror_kind` is read off the params by the symmetry augmentation, not here:
+    a pitch rotation is unchanged by the left-right mirror ("scalar"); a yaw one
+    is reversed, and the yaw task trains without the mirror.
+    """
+    del mirror_kind
+    cmd = env.command_manager.get_term(command_name)
+    return torch.stack(
+        [
+            cmd.turn / math.pi,
+            cmd.flight_turn / math.pi,
+            cmd.landed_turn / math.pi * (~cmd.second_jump).float(),
+            cmd.rate() / 10.0,
+        ],
+        dim=1,
+    )
+
+
+__all__ = ["turn_state"]
diff --git a/tasks/jumper/power_jumpspin/mdp/rewards.py b/tasks/jumper/power_jumpspin/mdp/rewards.py
new file mode 100644
index 0000000..186c88d
--- /dev/null
+++ b/tasks/jumper/power_jumpspin/mdp/rewards.py
@@ -0,0 +1,68 @@
+"""The rotation objective, for the turning jumps.
+
+Two terms, the rotation's version of `ref_free_jump`'s `apex_height` and
+`flight_height`:
+
+- `landed_turn`, the objective: how far the body turned in its own flight,
+  latched at the touchdown and paid every step after it, up to `cap`. Like the
+  apex, a second jump takes back everything it has paid. A landing that tips
+  past the tilt limit ends the episode as a failure, so a turn is only paid for
+  as long as the robot stays up after it.
+- `flight_turn_rate`, its dense half: the rotation rate while in the own
+  flight, so that a faster turn pays before the landing does.
+
+**Past the cap.** The first runs clamped `landed_turn` at the cap and paid the
+rate in the air without one, and both turning jumps went past a full turn and
+kept going: `pw-jspin-L` turned 384 degrees in the air by iteration 1500 and 630
+by 2998, and `pw-flip-r15` 417, touching down on its rear feet 59 degrees
+nose-up (means, the tilt a median, over 32 DR-on trials on native:cpu;
+`docs/CRABCRAFT_POWER.md`). Over-rotation was still paid by the rate term and
+cost nothing in the latch. With `tent=True` the latch pays `cap - |turn - cap|`,
+most for landing at the cap exactly and less on either side, and with `cap`
+given the rate term stops paying once the flight has turned that far.
+
+Neither pays for turning on the ground. Rotation built up before the takeoff is
+paid only through what it carries into the air.
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+
+
+def landed_turn(
+    env,
+    command_name: str = "jump",
+    scale: float = math.pi,
+    cap: float = 2 * math.pi,
+    tent: bool = False,
+) -> torch.Tensor:
+    """The own flight's rotation in units of `scale`, paid every step once the
+    jump has landed; clawed back by a second jump exactly as `ref_free_jump`'s
+    `apex_height` is, on the same step count.
+
+    Clamped to [0, `cap`]; with `tent`, `cap - |turn - cap|` floored at 0
+    instead, so that turning past the cap pays less than landing on it."""
+    cmd = env.command_manager.get_term(command_name)
+    t = cmd.landed_turn
+    paid = (cap - (t - cap).abs()).clamp(min=0.0) if tent else t.clamp(min=0.0, max=cap)
+    paying = (cmd.landed & ~cmd.second_jump).float()
+    return paid / scale * (paying - cmd.clawback_pending.float() * cmd.paid_steps)
+
+
+def flight_turn_rate(
+    env, command_name: str = "jump", max_rate: float = 60.0, cap: float | None = None
+) -> torch.Tensor:
+    """The counted rotation's rate, rad/s, while the own flight is in the air
+    and, with `cap`, has turned less than `cap`; 0 otherwise. Clamped only
+    against a simulation blow-up."""
+    cmd = env.command_manager.get_term(command_name)
+    flying = cmd.in_flight
+    if cap is not None:
+        flying = flying & (cmd.flight_turn < cap)
+    return cmd.rate().clamp(-max_rate, max_rate) * flying.float()
+
+
+__all__ = ["flight_turn_rate", "landed_turn"]
