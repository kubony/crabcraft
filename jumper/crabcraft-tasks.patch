@@ -0,0 +1,32 @@
+"""Copy a checkpoint with its policy's action noise capped.
+
+    python tools/cap_noise.py <in model_N.pt> <out .pt> <cap>
+
+The settled jumps (`docs/CRABCRAFT_POWER.md`, "Settling after the landing") resumed
+the shipped checkpoints with `std_param` clamped at 0.15, so that the settling
+charges started on the policy's own shaking rather than on its exploration noise
+(0.9 to 1.3 for the back flip). Everything else -- actor, critic, optimiser,
+iteration -- is copied as it is, so `scripts/train.py --checkpoint` resumes it.
+"""
+
+from __future__ import annotations
+
+import sys
+
+import torch
+
+
+def main() -> None:
+    if len(sys.argv) != 4:
+        raise SystemExit(__doc__)
+    src, dst, cap = sys.argv[1], sys.argv[2], float(sys.argv[3])
+    ckpt = torch.load(src, map_location="cpu", weights_only=False)
+    std = ckpt["actor_state_dict"]["distribution.std_param"]
+    print("std before", [round(float(x), 3) for x in std])
+    ckpt["actor_state_dict"]["distribution.std_param"] = std.clamp(max=cap)
+    print("std after ", [round(float(x), 3) for x in ckpt["actor_state_dict"]["distribution.std_param"]])
+    torch.save(ckpt, dst)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/eval_calm.py b/tools/eval_calm.py
new file mode 100644
index 0000000..f093a3b
--- /dev/null
+++ b/tools/eval_calm.py
@@ -0,0 +1,327 @@
+"""How still a shipped jump stands after its landing (native MuJoCo, CPU).
+
+Run from the repository root, with the repository on PYTHONPATH:
+
+    PYTHONPATH=. .venv/bin/python tools/eval_calm.py --task backflip \
+        --checkpoint <model_N.pt> --dr off --envs 4 --out <dir>
+    PYTHONPATH=. .venv/bin/python tools/eval_calm.py --task jumpspin720 \
+        --checkpoint <model_N.pt> --dr on --envs 16 --out <dir>
+
+Every environment is handed over the controller's way (`handover_start`): held
+at HOME for `--hold` seconds (0.3 by default; one value or a range LO HI drawn
+per environment), up to `--pose-offset` radians off it, then the deterministic
+policy (the distribution's mean) runs to `--seconds` from the reset, 4 by
+default, with no back-at-HOME termination. "dr off" and "dr on" are
+`tools/eval_power.py`'s; `--no-push` keeps "dr on" but for the pushes, which kick
+the base at up to 30 deg/s in roll and pitch every 1 to 3 s.
+
+Measured per environment over the **window**, from `--after` seconds after the
+landing (0.5) to the end, on the 20 gait joints:
+
+- `joint_speed_rms`: the joints' speed, RMS over joints and steps, rad/s;
+- `roll_pitch_rate_rms`: the base's body-frame roll and pitch rate, RMS over the
+  two and the steps, deg/s;
+- `saturated_steps`: the share of steps with any gait joint's actuator force
+  over 1.70 N*m (the plateau is 1.746); `saturated_joint_steps`: the share of
+  joint-steps;
+- `tremor_rms`: each joint's angle less its 0.2 s moving average, RMS, deg: the
+  worst joint, its name, and the median joint;
+- `chatter`: for each joint, the peak of that high-passed angle's spectrum above
+  1 Hz; a joint *chatters* when the peak is above 10 Hz and its `tremor_rms` is at
+  least 0.1 deg. Reported: how many joints chatter, the worst joint's peak, and
+  the largest RMS of any joint's motion above 10 Hz, deg;
+- `torque_chatter`: the same of the actuator force, which the joint's inertia
+  hides from its angle -- a target alternating step by step moves the joint a
+  tenth of a degree and swings its torque across the plateau. A joint's torque
+  chatters when its force's spectrum peaks above 10 Hz and its RMS above 10 Hz
+  is at least 0.1 N*m. Reported: how many joints, the largest RMS above 10 Hz
+  (N*m), and the largest RMS above 10 Hz of any joint's target (deg);
+- `second_diff`: the mean |q[k+1] - 2 q[k] + q[k-1]| per step, deg, over the
+  window and in 0.25 s windows from the landing;
+- `settled_after_go_s`: the hand-back moment -- the first time, after the
+  landing, from which the next `--hold-calm` seconds (0.3) are settled: at every
+  step the landing's own motion is over -- the joint velocities averaged over a
+  sliding 0.1 s under 0.2 rad/s RMS over the joints, the roll and pitch rate so
+  averaged under 5 deg/s, the tilt under 10 deg -- and over the span the
+  acceptance's two rates hold, the joint speed under 1.0 rad/s RMS and the roll
+  and pitch rate under 15 deg/s RMS. Seconds after the go, so what a
+  controller's fixed delay after the handover has to cover. None if never;
+- `home_after_go_s`: when `ref_free_jump`'s back-at-HOME test first holds -- 20
+  joints within 0.05 rad RMS of HOME and their mean squared speed under 0.5
+  (rad/s)^2, for 0.1 s -- seconds after the go.
+
+Writes <out>/<task>_<dr>.npz (per-step arrays) and prints a JSON line of metrics,
+each per environment and summarised (the median and the worst over them).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from dataclasses import asdict
+from pathlib import Path
+
+import numpy as np
+import torch
+
+TASKS = {"backflip": "jumper.power_backflip", "jumpspin720": "jumper.power_jumpspin720"}
+SATURATED_NM = 1.70
+CHATTER_HZ = 10.0
+CHATTER_MIN_DEG = 0.1
+CHATTER_MIN_NM = 0.1
+ACTION_SCALE = 0.5
+TREMOR_WINDOW_S = 0.2
+CALM_SPEED = 1.0
+CALM_RATE_DEG = 15.0
+CALM_DRIFT_SPEED = 0.2
+CALM_SWAY_DEG = 5.0
+CALM_TILT_DEG = 10.0
+CALM_SMOOTH_S = 0.1
+
+
+def _moving_average(x: np.ndarray, k: int) -> np.ndarray:
+    """Centred moving average along axis 0, the ends padded with their own value."""
+    pad = k // 2
+    xp = np.concatenate([np.repeat(x[:1], pad, 0), x, np.repeat(x[-1:], k - 1 - pad, 0)], 0)
+    c = np.cumsum(np.concatenate([np.zeros_like(x[:1]), xp], 0), 0)
+    return (c[k:] - c[:-k]) / k
+
+
+def _above(x: np.ndarray, dt: float, hz: float) -> tuple[np.ndarray, np.ndarray]:
+    """Per column of `x`: the RMS of its content above `hz`, and its spectrum's
+    peak frequency above 1 Hz."""
+    x = x - x.mean(0)
+    f = np.fft.rfftfreq(len(x), dt)
+    spec = np.abs(np.fft.rfft(x * np.hanning(len(x))[:, None], axis=0))
+    spec[f < 1.0] = 0.0
+    F = np.fft.rfft(x, axis=0)
+    F[f <= hz] = 0.0
+    hi = np.fft.irfft(F, n=len(x), axis=0)
+    return np.sqrt((hi**2).mean(0)), f[np.argmax(spec, axis=0)]
+
+
+def analyse(t, q, qd, tau, angv, grav, landed, go, home, dt, joints, after, hold_calm,
+            act=None):
+    """Per-environment metrics; see the module docstring."""
+    E = q.shape[1]
+    out = []
+    k_hp = round(TREMOR_WINDOW_S / dt)
+    k_sm = round(CALM_SMOOTH_S / dt)
+    k_hold = round(hold_calm / dt)
+    tilt = np.degrees(np.arccos(np.clip(-grav[..., 2], -1.0, 1.0)))
+    for e in range(E):
+        up = landed[:, e] > 0.5
+        if not up.any():
+            out.append({"landed_s": None})
+            continue
+        li = int(np.argmax(up))
+        tl = float(t[li])
+        w = t >= tl + after - 1e-9
+        qe, qde, taue = q[:, e], qd[:, e], tau[:, e]
+        hp = qe - _moving_average(qe, k_hp)
+        tremor = np.degrees(np.sqrt((hp[w] ** 2).mean(0)))
+        hi_rms, peak = _above(hp[w], dt, CHATTER_HZ)
+        hi_rms = np.degrees(hi_rms)
+        chatter = (peak > CHATTER_HZ) & (tremor >= CHATTER_MIN_DEG)
+        tau_hi, tau_peak = _above(taue[w], dt, CHATTER_HZ)
+        tau_chatter = (tau_peak > CHATTER_HZ) & (tau_hi >= CHATTER_MIN_NM)
+        target_hi = (np.degrees(_above(act[w, e] * ACTION_SCALE, dt, CHATTER_HZ)[0].max())
+                     if act is not None else float("nan"))
+        jw = int(np.argmax(tremor))
+        d2 = np.abs(qe[2:] - 2 * qe[1:-1] + qe[:-2])  # at t[1:-1]
+        tm = t[1:-1]
+        windows = []
+        s = tl
+        while s + 0.25 <= t[-1] + 1e-9:
+            m = (tm >= s) & (tm < s + 0.25)
+            windows.append(round(float(np.degrees(d2[m].mean())), 3))
+            s += 0.25
+        # The hand-back moment: the landing's own motion over (the 0.1 s averages
+        # of the joint speeds and of the roll and pitch rate small at every step)
+        # and what is left as calm as the acceptance asks over the whole span.
+        drift_speed = np.sqrt((_moving_average(qde, k_sm) ** 2).mean(1))
+        sway = np.degrees(np.linalg.norm(_moving_average(angv[:, e, :2], k_sm), axis=1))
+        still = (drift_speed < CALM_DRIFT_SPEED) & (sway < CALM_SWAY_DEG) & (tilt[:, e] < CALM_TILT_DEG)
+        speed_sq = _moving_average((qde**2).mean(1)[:, None], k_hold)[:, 0]
+        rate_sq = _moving_average((np.degrees(angv[:, e, :2]) ** 2).mean(1)[:, None], k_hold)[:, 0]
+        half = k_hold // 2
+        settled = None
+        for i in range(li, len(t) - k_hold + 1):
+            c = i + half  # the centred average over [i, i + k_hold)
+            if (still[i:i + k_hold].all() and speed_sq[c] < CALM_SPEED**2
+                    and rate_sq[c] < CALM_RATE_DEG**2):
+                settled = float(t[i] - go[e])
+                break
+        rms_home = np.sqrt(((qe - home) ** 2).mean(1))
+        back = (t >= tl) & (rms_home < 0.05) & ((qde**2).mean(1) < 0.5)
+        home_t = None
+        run = 0
+        for i in range(len(t)):
+            run = run + 1 if back[i] else 0
+            if run >= 20:
+                home_t = float(t[i] - go[e])
+                break
+        out.append({
+            "go_s": round(float(go[e]), 3),
+            "landed_s": round(tl, 3),
+            "landed_after_go_s": round(tl - float(go[e]), 3),
+            "joint_speed_rms": round(float(np.sqrt((qde[w] ** 2).mean())), 3),
+            "roll_pitch_rate_rms": round(float(np.degrees(np.sqrt((angv[w, e, :2] ** 2).mean()))), 2),
+            "saturated_steps": round(float((np.abs(taue[w]) > SATURATED_NM).any(1).mean()), 4),
+            "saturated_joint_steps": round(float((np.abs(taue[w]) > SATURATED_NM).mean()), 4),
+            "tremor_rms_worst_deg": round(float(tremor[jw]), 3),
+            "tremor_worst_joint": joints[jw],
+            "tremor_rms_median_deg": round(float(np.median(tremor)), 3),
+            "chatter_joints": int(chatter.sum()),
+            "worst_joint_peak_hz": round(float(peak[jw]), 1),
+            "above_10hz_rms_max_deg": round(float(hi_rms.max()), 3),
+            "torque_chatter_joints": int(tau_chatter.sum()),
+            "torque_above_10hz_rms_max_nm": round(float(tau_hi.max()), 3),
+            "torque_chatter_worst_joint": joints[int(np.argmax(tau_hi))],
+            "target_above_10hz_rms_max_deg": round(float(target_hi), 2),
+            "second_diff_deg": round(float(np.degrees(d2[w[1:-1]].mean())), 3),
+            "second_diff_0p25s_deg": windows,
+            "settled_after_go_s": None if settled is None else round(settled, 3),
+            "home_after_go_s": None if home_t is None else round(home_t, 3),
+            "tilt_max_window_deg": round(float(tilt[w, e].max()), 1),
+        })
+    return out
+
+
+def summarise(per_env: list[dict]) -> dict:
+    """Median and worst over the environments that landed."""
+    got = [m for m in per_env if m.get("landed_s") is not None]
+    s: dict = {"landed": len(got), "envs": len(per_env)}
+    worst_is_max = {"joint_speed_rms", "roll_pitch_rate_rms", "saturated_steps",
+                    "saturated_joint_steps", "tremor_rms_worst_deg", "chatter_joints",
+                    "above_10hz_rms_max_deg", "second_diff_deg", "tilt_max_window_deg",
+                    "torque_chatter_joints", "torque_above_10hz_rms_max_nm",
+                    "target_above_10hz_rms_max_deg",
+                    "landed_after_go_s"}
+    for key in sorted(worst_is_max):
+        v = np.array([m[key] for m in got], dtype=float)
+        if v.size:
+            s[key] = {"median": round(float(np.median(v)), 4), "worst": round(float(v.max()), 4)}
+    for key in ("settled_after_go_s", "home_after_go_s"):
+        v = [m[key] for m in got]
+        ok = np.array([x for x in v if x is not None], dtype=float)
+        s[key] = {"never": sum(x is None for x in v),
+                  "median": None if not ok.size else round(float(np.median(ok)), 3),
+                  "worst": None if not ok.size else round(float(ok.max()), 3)}
+    return s
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--task", required=True, choices=sorted(TASKS))
+    ap.add_argument("--checkpoint", required=True, type=Path)
+    ap.add_argument("--out", required=True, type=Path)
+    ap.add_argument("--dr", choices=("off", "on"), default="off")
+    ap.add_argument("--no-push", action="store_true", help="dr on without the pushes")
+    ap.add_argument("--envs", type=int, default=4)
+    ap.add_argument("--seconds", type=float, default=4.0)
+    ap.add_argument("--hold", type=float, nargs="+", default=[0.3], metavar="S")
+    ap.add_argument("--pose-offset", type=float, default=0.0, metavar="RAD")
+    ap.add_argument("--after", type=float, default=0.5,
+                    help="the window starts this long after the landing")
+    ap.add_argument("--hold-calm", type=float, default=0.3,
+                    help="seconds of calm the hand-back moment needs ahead of it")
+    ap.add_argument("--seed", type=int, default=5)
+    args = ap.parse_args()
+    if not 1 <= len(args.hold) <= 2:
+        ap.error("--hold takes one value or two")
+
+    import mjrl.backend.select as sel
+    from mjrl.backend import resolve
+
+    sel.use_backend(resolve(backend="native", device="cpu", num_envs=args.envs, training=False))
+    from mjlab.envs import ManagerBasedRlEnv
+    from mjlab.rl import RslRlVecEnvWrapper
+    from mjlab.rl.runner import MjlabOnPolicyRunner
+
+    import tasks
+    from tasks.jumper.common.constants import GAIT_JOINTS
+    from tasks.jumper.power_jumpspin.env_cfg import handover_start
+
+    task = TASKS[args.task]
+    cfg = tasks.load_env_cfg(task, play=True)
+    train_cfg = tasks.load_env_cfg(task)
+    if args.dr == "off":
+        for name in ("base_com", "encoder_bias", "foot_friction", "push_robot"):
+            cfg.events.pop(name, None)
+    else:
+        if not args.no_push:
+            cfg.events["push_robot"] = train_cfg.events["push_robot"]
+        cfg.observations["actor"] = train_cfg.observations["actor"]
+    handover_start(cfg, play=True, hold_range=(args.hold[0], args.hold[-1]),
+                   pose_range=args.pose_offset)
+    cfg.terminations.pop("back_home", None)
+    cfg.episode_length_s = args.seconds
+    cfg.scene.num_envs = args.envs
+    cfg.seed = args.seed
+
+    agent_cfg = tasks.load_agent_cfg(task)
+    env = ManagerBasedRlEnv(cfg=cfg, device="cpu")
+    wrapped = RslRlVecEnvWrapper(env, clip_actions=agent_cfg.clip_actions)
+    runner_cls = tasks.load_runner_cls(task) or MjlabOnPolicyRunner
+    runner = runner_cls(wrapped, asdict(agent_cfg), device="cpu")
+    runner.load(str(args.checkpoint), load_cfg={"actor": True}, strict=True, map_location="cpu")
+    policy = runner.get_inference_policy(device="cpu")
+
+    robot = env.scene["robot"]
+    names = list(robot.joint_names)
+    gid = [names.index(j) for j in GAIT_JOINTS]
+    act_names = list(robot.actuator_names)
+    aid = [act_names.index(j) for j in GAIT_JOINTS]
+    cmd = env.command_manager.get_term("jump")
+    dt = env.step_dt
+    # One episode: stop at the step before the time-out resets the environments.
+    n = round(args.seconds / dt) - 1
+    E = args.envs
+    q = np.zeros((n, E, len(gid)))
+    qd = np.zeros_like(q)
+    tau = np.zeros_like(q)
+    act = np.zeros((n, E, len(gid)))
+    angv = np.zeros((n, E, 3))
+    grav = np.zeros((n, E, 3))
+    landed = np.zeros((n, E))
+    failed = np.zeros(E, dtype=bool)
+    home = robot.data.default_joint_pos.cpu().numpy()[0, gid]
+
+    obs, _ = wrapped.reset()
+    go = cmd.go_step.cpu().numpy() * dt
+    with torch.inference_mode():
+        for k in range(n):
+            a = policy(obs)
+            obs, _, dones, _ = wrapped.step(a)
+            d = robot.data
+            failed |= dones.cpu().numpy().astype(bool)
+            q[k] = d.joint_pos.cpu().numpy()[:, gid]
+            qd[k] = d.joint_vel.cpu().numpy()[:, gid]
+            tau[k] = d.actuator_force.cpu().numpy()[:, aid]
+            act[k] = a.cpu().numpy()[:, :len(gid)]
+            angv[k] = d.root_link_ang_vel_b.cpu().numpy()
+            grav[k] = d.projected_gravity_b.cpu().numpy()
+            landed[k] = cmd.landed.float().cpu().numpy()
+    t = (np.arange(n) + 1) * dt
+    per_env = analyse(t, q, qd, tau, angv, grav, landed, go, home, dt, list(GAIT_JOINTS),
+                      args.after, args.hold_calm, act=act)
+    for e in np.nonzero(failed)[0]:
+        per_env[e] = {"landed_s": None, "ended_early": True}
+    metrics = {"task": task, "checkpoint": str(args.checkpoint), "dr": args.dr,
+               "push": args.dr == "on" and not args.no_push, "envs": E, "seed": args.seed,
+               "hold_s": args.hold, "pose_offset_rad": args.pose_offset, "seconds": args.seconds,
+               "after_landing_s": args.after, "ended_early": int(failed.sum()),
+               "summary": summarise(per_env), "per_env": per_env}
+    args.out.mkdir(parents=True, exist_ok=True)
+    tag = args.dr + ("_nopush" if args.dr == "on" and args.no_push else "")
+    np.savez_compressed(args.out / f"{args.task}_{tag}.npz", t=t, q=q, qd=qd, tau=tau, act=act,
+                        angv=angv, grav=grav, landed=landed, go=go, dt=dt,
+                        joints=np.array(GAIT_JOINTS), metrics=np.array(json.dumps(metrics)))
+    print("METRICS " + json.dumps(metrics))
+    env.close()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/eval_power.py b/tools/eval_power.py
new file mode 100644
index 0000000..db87408
--- /dev/null
+++ b/tools/eval_power.py
@@ -0,0 +1,373 @@
+"""Evaluate a jumper.power_* checkpoint in the task's own environment (native MuJoCo, CPU).
+
+Run from the repository root, with the repository on PYTHONPATH so that `tasks`
+is this checkout's:
+
+    PYTHONPATH=. .venv/bin/python tools/eval_power.py --task spin \
+        --checkpoint <model_N.pt> --dr off --envs 4 --out <dir>
+    PYTHONPATH=. .venv/bin/python tools/eval_power.py --task jumpspin \
+        --checkpoint <model_N.pt> --dr on --envs 32 --out <dir>
+
+The acceptance numbers for these three experiments, not the training reward.
+`--task jumpspin` with `--checkpoint tasks/jumper/ref_free_jump/out/example/model_5999.pt`
+measures the warm start itself: the plain jump every turning run starts from.
+
+Every environment starts at HOME (play mode: no reference-state spawns, the
+spin's random heading kept) and the deterministic policy (the distribution's
+mean) runs until each environment's first termination or `--seconds`.
+
+**The handover** (`--hold`, the jumps only): each environment stands at HOME for a
+hold drawn from the range given, the action at zero, and is handed to the policy
+at the go with its observation history emptied -- the start the bundle's
+controller gives a mode (`tasks/jumper/power_jumpspin/mdp/handover.py`).
+`--pose-offset` spawns every gait joint up to that many radians off HOME first.
+`--hold 0` is mjlab's reset itself, the start the jumps trained from until the
+handover existed. Without `--hold`, the task's own replay config decides.
+`--keep-running` drops the back-at-HOME termination, to see whether and when the
+policy jumps a second time once it has landed and settled.
+"dr off" removes the startup randomisation (base CoM offset, encoder bias, foot
+friction -- the feet keep the model's nominal 1.2), the pushes and the
+observation noise; "dr on" keeps the training's: those three, the pushes, and
+the actor's observation noise at the training levels.
+
+Measured per environment:
+
+- spin: yaw turned (integrated world yaw rate), the mean rate in rev/s over the
+  window from `--settle` seconds to the end, the best 1 s window, the base's
+  horizontal drift from its spawn (final and largest), the largest tilt, the
+  share of steps with any non-foot part on the ground;
+- jumpspin / backflip: whether the episode made its own jump, the apex rise of
+  its lowest point, the flight time, the rotation in the air (the command's
+  latched `landed_turn`, or `flight_turn` if it never landed), the largest
+  rotation over the whole episode, the tilt at the touchdown and 0.3 s after
+  it, and how the episode ended. An upright landing is a jump that landed and ended at HOME
+  or at the time limit -- not by a tilt or crash termination -- with the tilt
+  under 30 degrees 0.3 s after its touchdown.
+
+Both: the peak |actuator force| per gait joint and the peak |joint speed|, over
+every environment and step, against the 1.7464 N*m plateau.
+
+Writes <out>/<task>_<dr>.npz (per-step arrays) and prints a JSON line of metrics.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from dataclasses import asdict
+from pathlib import Path
+
+import numpy as np
+import torch
+
+TASKS = {"spin": "jumper.power_spin", "jumpspin": "jumper.power_jumpspin",
+         "backflip": "jumper.power_backflip",
+         # The variants World of Crabcraft ships, each one constant from its parent.
+         "spin_feet": "jumper.power_spin_feet", "jumpspin720": "jumper.power_jumpspin720"}
+SPINS = {"spin", "spin_feet"}
+FAILURES = {"fell_over", "chassis_crash", "tipped_on_feet"}
+
+
+def tilt_deg(gravity_b: np.ndarray) -> np.ndarray:
+    return np.degrees(np.arccos(np.clip(-gravity_b[..., 2], -1.0, 1.0)))
+
+
+def stress_contacts(cfg, foot_torsion: float | None, nonfoot_friction: float | None) -> None:
+    """Rewrite the robot's collision config for a contact stress test.
+
+    The model's feet are condim 3 -- no torsional friction, so a planted foot pivots
+    for free -- and every other geom is condim 1 at priority 0, which against the
+    priority-0 plane comes out as condim 3 at the plane's friction 1.0. A spin that
+    pivots on its feet and leans on its calves is helped by both; this measures by
+    how much. The foot's sliding friction stays the model's 1.2.
+    """
+    import dataclasses
+
+    robot = cfg.scene.entities["robot"]
+    (col,) = robot.collisions
+    foot_re = next(k for k in col.condim if k != ".*")
+    condim, priority, friction = dict(col.condim), dict(col.priority), dict(col.friction)
+    if foot_torsion is not None:
+        condim[foot_re] = 4
+        friction[foot_re] = (friction[foot_re][0], foot_torsion, friction[foot_re][2])
+    if nonfoot_friction is not None:
+        condim[".*"] = 3
+        priority[".*"] = 1
+        friction[".*"] = (nonfoot_friction, 0.005, 0.0001)
+    robot.collisions = (dataclasses.replace(col, condim=condim, priority=priority,
+                                            friction=friction),)
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--task", required=True, choices=sorted(TASKS))
+    ap.add_argument("--checkpoint", required=True, type=Path)
+    ap.add_argument("--dr", choices=("off", "on"), default="off")
+    ap.add_argument("--envs", type=int, default=4)
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("--seconds", type=float, default=None,
+                    help="longest a rollout runs; default the task's episode length")
+    ap.add_argument("--settle", type=float, default=2.0,
+                    help="spin: seconds of spin-up left out of the sustained rate")
+    ap.add_argument("--out", type=Path, required=True)
+    ap.add_argument("--backend", choices=("native", "warp"), default="native",
+                    help="warp on cpu is a slow serial path; it is here to compare the two "
+                    "backends' contacts on the same policy")
+    ap.add_argument("--device", default="cpu")
+    ap.add_argument("--foot-torsion", type=float, default=None, metavar="M",
+                    help="contact stress: feet at condim 4 with this torsional friction "
+                    "(MuJoCo's default is 0.005), so a planted foot no longer pivots for free")
+    ap.add_argument("--nonfoot-friction", type=float, default=None, metavar="MU",
+                    help="contact stress: every non-foot geom at this sliding friction against "
+                    "the floor (condim 3, priority over the plane), instead of the plane's 1.0")
+    ap.add_argument("--hold", type=float, nargs="+", default=None, metavar="S",
+                    help="jumps: the handover -- seconds standing at HOME before the policy "
+                    "acts, one value or a range LO HI drawn per environment; 0 is mjlab's reset")
+    ap.add_argument("--pose-offset", type=float, default=0.0, metavar="RAD",
+                    help="with --hold: every gait joint spawned up to this far off HOME")
+    ap.add_argument("--keep-running", action="store_true",
+                    help="jumps: no back-at-HOME termination, so a second jump shows")
+    args = ap.parse_args()
+    if args.hold is not None and not 1 <= len(args.hold) <= 2:
+        ap.error("--hold takes one value or two")
+
+    import mjrl.backend.select as sel
+    from mjrl.backend import resolve
+
+    res = resolve(backend=args.backend, device=args.device, num_envs=args.envs, training=False)
+    sel.use_backend(res)
+
+    from mjlab.envs import ManagerBasedRlEnv
+    from mjlab.rl import RslRlVecEnvWrapper
+    from mjlab.rl.runner import MjlabOnPolicyRunner
+
+    import tasks
+    from tasks.jumper.common.constants import EFFORT_LIMIT, GAIT_JOINTS
+
+    task = TASKS[args.task]
+    cfg = tasks.load_env_cfg(task, play=True)
+    train_cfg = tasks.load_env_cfg(task)
+    if args.dr == "off":
+        for name in ("base_com", "encoder_bias", "foot_friction", "push_robot"):
+            cfg.events.pop(name, None)
+    else:
+        cfg.events["push_robot"] = train_cfg.events["push_robot"]
+        # The training's actor group whole: the strided history carries its
+        # frames' noise in its params, which play mode built without.
+        cfg.observations["actor"] = train_cfg.observations["actor"]
+    if args.foot_torsion is not None or args.nonfoot_friction is not None:
+        stress_contacts(cfg, args.foot_torsion, args.nonfoot_friction)
+    if args.hold is not None:
+        if args.task in SPINS:
+            ap.error("--hold is the jumps' handover; the spin has no go")
+        from tasks.jumper.power_jumpspin.env_cfg import handover_start
+
+        lo, hi = (args.hold[0], args.hold[-1])
+        handover_start(cfg, play=True, hold_range=(lo, hi), pose_range=args.pose_offset)
+    if args.keep_running:
+        cfg.terminations.pop("back_home", None)
+    if args.seconds is not None:
+        cfg.episode_length_s = args.seconds
+    cfg.scene.num_envs = args.envs
+    cfg.seed = args.seed
+    agent_cfg = tasks.load_agent_cfg(task)
+    env = ManagerBasedRlEnv(cfg=cfg, device=args.device)
+    wrapped = RslRlVecEnvWrapper(env, clip_actions=agent_cfg.clip_actions)
+    runner_cls = tasks.load_runner_cls(task) or MjlabOnPolicyRunner
+    runner = runner_cls(wrapped, asdict(agent_cfg), device=args.device)
+    runner.load(str(args.checkpoint), load_cfg={"actor": True}, strict=True,
+                map_location=args.device)
+    policy = runner.get_inference_policy(device=args.device)
+
+    robot = env.scene["robot"]
+    joint_names = list(robot.joint_names)
+    gait_ids = [joint_names.index(j) for j in GAIT_JOINTS]
+    act_names = list(robot.actuator_names) if hasattr(robot, "actuator_names") else joint_names
+    origins = env.scene.env_origins.cpu().numpy()
+    dt = env.step_dt
+    n = round(cfg.episode_length_s / dt)
+    E = args.envs
+    term_names = list(env.termination_manager.active_terms)
+    cmd = env.command_manager.get_term("jump") if args.task not in SPINS else None
+
+    obs, _ = wrapped.reset()
+    # Each environment's go, drawn at the reset: the handover's moment.
+    go_s = cmd.go_step.cpu().numpy() * dt if cmd is not None else np.zeros(E)
+    pos = np.full((n, E, 3), np.nan)
+    grav = np.full((n, E, 3), np.nan)
+    yaw_rate = np.full((n, E), np.nan)
+    alive = np.ones(E, dtype=bool)
+    ended_at = np.full(E, np.nan)
+    why = [""] * E
+    tau_peak = np.zeros(len(act_names))
+    qd_peak = np.zeros(len(joint_names))
+    illegal = np.zeros(E)
+    body_sensor = env.scene.sensors.get("body_ground_contact") if hasattr(env.scene, "sensors") else None
+    # jump bookkeeping, last value seen while alive
+    jb = {k: np.zeros(E) for k in ("landed", "apex_rise", "landed_turn", "flight_turn",
+                                   "peak_turn", "turn", "in_flight", "second_jump")}
+    second_t = np.full(E, np.nan)
+    takeoff_t = np.full(E, np.nan)
+    touchdown_t = np.full(E, np.nan)
+    was_flying = np.zeros(E, dtype=bool)
+
+    def grab_jump(k: int, live: np.ndarray) -> None:
+        """Read the command's bookkeeping for the environments still in their
+        first episode; a done one has already been reset and keeps its last."""
+        nonlocal was_flying
+        st = {
+            "landed": cmd.landed.float().cpu().numpy(),
+            "apex_rise": cmd.apex_rise.cpu().numpy(),
+            "landed_turn": cmd.landed_turn.cpu().numpy(),
+            "flight_turn": cmd.flight_turn.cpu().numpy(),
+            "peak_turn": cmd.peak_turn.cpu().numpy(),
+            "turn": cmd.turn.cpu().numpy(),
+            "in_flight": cmd.in_flight.float().cpu().numpy(),
+            "second_jump": cmd.second_jump.float().cpu().numpy(),
+        }
+        flying = st["in_flight"] > 0.5
+        t = (k + 1) * dt
+        # The takeoff of the flight that becomes the jump: a hop that lands
+        # under `min_rise` is not the jump, and the next takeoff replaces it.
+        newly_up = flying & ~was_flying & live & (jb["landed"] < 0.5)
+        takeoff_t[newly_up] = t
+        down = ~flying & was_flying & live & np.isnan(touchdown_t) & (st["landed"] > 0.5)
+        touchdown_t[down] = t
+        again = (st["second_jump"] > 0.5) & live & np.isnan(second_t)
+        second_t[again] = t
+        was_flying = np.where(live, flying, was_flying)
+        for key, v in st.items():
+            jb[key] = np.where(live, v, jb[key])
+
+    with torch.inference_mode():
+        for k in range(n):
+            act = policy(obs)
+            obs, _, dones, _ = wrapped.step(act)
+            done = dones.cpu().numpy().astype(bool)
+            live = alive & ~done
+            data = robot.data
+            p = data.root_link_pos_w.cpu().numpy() - origins
+            g = data.projected_gravity_b.cpu().numpy()
+            w = data.root_link_ang_vel_w[:, 2].cpu().numpy()
+            pos[k, live] = p[live]
+            grav[k, live] = g[live]
+            yaw_rate[k, live] = w[live]
+            if live.any():
+                tau = data.actuator_force.abs().cpu().numpy()[live].max(axis=0)
+                tau_peak = np.maximum(tau_peak, tau)
+                qd = data.joint_vel.abs().cpu().numpy()[live].max(axis=0)
+                qd_peak = np.maximum(qd_peak, qd)
+                if body_sensor is not None:
+                    f = body_sensor.data.force.cpu().numpy()
+                    illegal += live * (np.linalg.norm(f, axis=-1) > 1.0).any(axis=1)
+            if cmd is not None:
+                grab_jump(k, live)
+            for e in np.nonzero(done & alive)[0]:
+                alive[e] = False
+                ended_at[e] = (k + 1) * dt
+                why[e] = ",".join(t for t in term_names
+                                  if bool(env.termination_manager.get_term(t)[e]))
+            if not alive.any():
+                break
+
+    t = (np.arange(n) + 1) * dt
+    tilt = tilt_deg(grav)
+    drift = np.linalg.norm(pos[..., :2], axis=-1)
+    gait_tau = {j: round(float(tau_peak[act_names.index(j)]), 3) for j in GAIT_JOINTS
+                if j in act_names}
+    metrics: dict = {
+        "task": task, "backend": f"{args.backend}:{args.device}", "dr": args.dr,
+        "foot_torsion": args.foot_torsion, "nonfoot_friction": args.nonfoot_friction, "envs": E, "seed": args.seed,
+        "checkpoint": str(args.checkpoint),
+        "episode_s": cfg.episode_length_s,
+        "ended_at_s": [None if math.isnan(x) else round(float(x), 3) for x in ended_at],
+        "terminations": why,
+        "failures": int(sum(any(f in w.split(",") for f in FAILURES) for w in why)),
+        "max_tilt_deg": [round(float(np.nanmax(tilt[:, e])), 1) for e in range(E)],
+        "peak_torque_Nm_max": round(float(max(gait_tau.values())), 3),
+        "peak_torque_Nm_per_joint": gait_tau,
+        "plateau_Nm": round(float(EFFORT_LIMIT), 4),
+        "peak_joint_speed_rad_s_max": round(float(qd_peak[gait_ids].max()), 2),
+        "nonfoot_ground_contact_share": [round(float(illegal[e] / max(1, np.sum(~np.isnan(yaw_rate[:, e])))), 3)
+                                         for e in range(E)],
+    }
+    if args.task in SPINS:
+        yaw = np.nancumsum(np.nan_to_num(yaw_rate), axis=0) * dt
+        lived = ~np.isnan(yaw_rate)
+        win = (t >= args.settle)[:, None] & lived
+        rev_s = [float(np.sum(yaw_rate[win[:, e], e]) * dt / (2 * math.pi)
+                       / max(dt, np.sum(win[:, e]) * dt)) for e in range(E)]
+        k1 = round(1.0 / dt)
+        best = []
+        for e in range(E):
+            r = np.nan_to_num(yaw_rate[:, e])
+            c = np.convolve(r, np.ones(k1), "valid") * dt / (2 * math.pi)
+            best.append(float(c.max()) if c.size else float("nan"))
+        metrics.update({
+            "settle_s": args.settle,
+            "turns_total": [round(float(yaw[lived[:, e], e][-1] / (2 * math.pi)), 2) if lived[:, e].any() else None
+                            for e in range(E)],
+            "sustained_rev_s": [round(x, 3) for x in rev_s],
+            "sustained_rev_s_mean": round(float(np.mean(rev_s)), 3),
+            "best_1s_rev_s": [round(x, 3) for x in best],
+            "drift_final_m": [round(float(drift[lived[:, e], e][-1]), 3) if lived[:, e].any() else None
+                              for e in range(E)],
+            "drift_max_m": [round(float(np.nanmax(drift[:, e])), 3) for e in range(E)],
+            "mean_tilt_deg_after_settle": [round(float(np.nanmean(tilt[win[:, e], e])), 1) for e in range(E)],
+        })
+    else:
+        landed = jb["landed"] > 0.5
+        air_turn = np.where(landed, jb["landed_turn"], jb["flight_turn"])
+        flight_s = touchdown_t - takeoff_t
+        tilt_after = []
+        for e in range(E):
+            if math.isnan(touchdown_t[e]):
+                tilt_after.append(None)
+                continue
+            k = round((touchdown_t[e] + 0.3) / dt) - 1
+            k = min(k, n - 1)
+            v = tilt[k, e]
+            tilt_after.append(None if math.isnan(v) else round(float(v), 1))
+        tilt_td = []
+        for e in range(E):
+            if math.isnan(touchdown_t[e]):
+                tilt_td.append(None)
+                continue
+            v = tilt[min(round(touchdown_t[e] / dt) - 1, n - 1), e]
+            tilt_td.append(None if math.isnan(v) else round(float(v), 1))
+        upright = [bool(landed[e]) and not any(f in why[e].split(",") for f in FAILURES)
+                   and tilt_after[e] is not None and tilt_after[e] < 30.0 for e in range(E)]
+        metrics.update({
+            "hold_s": args.hold, "pose_offset_rad": args.pose_offset,
+            "keep_running": args.keep_running,
+            "go_s": [round(float(x), 3) for x in go_s],
+            "takeoff_after_go_s": [None if math.isnan(x) else round(float(x - g), 3)
+                                   for x, g in zip(takeoff_t, go_s)],
+            "second_jump": int(np.sum(~np.isnan(second_t))),
+            "second_jump_after_touchdown_s": [None if math.isnan(x) else round(float(x - d), 3)
+                                              for x, d in zip(second_t, touchdown_t)],
+            "jumped": int(landed.sum()),
+            "apex_rise_m": [round(float(x), 3) for x in jb["apex_rise"]],
+            "flight_s": [None if math.isnan(x) else round(float(x), 3) for x in flight_s],
+            "air_turn_deg": [round(float(np.degrees(x)), 1) for x in air_turn],
+            "peak_turn_deg": [round(float(np.degrees(x)), 1) for x in jb["peak_turn"]],
+            "final_turn_deg": [round(float(np.degrees(x)), 1) for x in jb["turn"]],
+            "tilt_at_touchdown_deg": tilt_td,
+            "tilt_0p3s_after_touchdown_deg": tilt_after,
+            "upright_landings": int(sum(upright)),
+            "air_turn_deg_mean": round(float(np.degrees(air_turn).mean()), 1),
+            "air_turn_deg_min_max": [round(float(np.degrees(air_turn).min()), 1),
+                                     round(float(np.degrees(air_turn).max()), 1)],
+            "apex_rise_m_mean": round(float(jb["apex_rise"].mean()), 3),
+        })
+    args.out.mkdir(parents=True, exist_ok=True)
+    np.savez_compressed(args.out / f"{args.task}_{args.dr}.npz", t=t, pos=pos, grav=grav,
+                        yaw_rate=yaw_rate, tau_peak=tau_peak, qd_peak=qd_peak,
+                        names=np.array(act_names), metrics=np.array(json.dumps(metrics)))
+    print("METRICS " + json.dumps(metrics))
+    env.close()
+
+
+if __name__ == "__main__":
+    main()
