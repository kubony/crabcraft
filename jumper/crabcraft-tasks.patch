+    return jumper_ppo_baseline(
+        experiment_name="jumper.power_backflip",
+        # On, as ref_free_jump trained: a flip about the pitch axis is its own
+        # mirror image, and every critic term this task adds is a scalar under it.
+        actor_hidden_dims=(512, 256, 128, 64),
+        critic_hidden_dims=(512, 256, 128, 64),
+        init_std=0.3,
+        entropy_coef=0.001,
+        gamma=0.99**0.25,
+        lam=0.95**0.25,
+        num_steps_per_env=NUM_STEPS_PER_ENV,
+        max_iterations=1500,
+    )
