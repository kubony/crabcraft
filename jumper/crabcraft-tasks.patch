diff --git a/tasks/jumper/power_backflip/env_cfg.py b/tasks/jumper/power_backflip/env_cfg.py
new file mode 100644
index 0000000..cfbcb6d
--- /dev/null
+++ b/tasks/jumper/power_backflip/env_cfg.py
@@ -0,0 +1,196 @@
+"""jumper.power_backflip -- a probe of the back flip: how far round does it get?
+
+A back flip on this robot would have to turn 360 degrees nose-up in the air and
+land on its feet. Its best vertical jump flies for 0.31 s (`docs/jumper_jump.md`),
+so a whole turn in the air needs about 20 rad/s of pitch rate on average, built
+up in a push of about 50 ms. This task asks for it and measures what comes back.
+
+## Built on jumper.power_jumpspin's turning jump
+
+`power_jumpspin.env_cfg.turning_jump_cfg`: `ref_free_jump`'s config with the
+recording's feedforward, prior and schedule taken down, a run that starts from
+`ref_free_jump`'s `model_5999` actor (`rl_cfg.py`), and the rotation counted --
+here about the pitch axis, nose up positive (`power_jumpspin/mdp/commands.py`).
+
+## The objective
+
+- `flight_turn_rate`, the probe's main signal: the nose-up pitch rate while in
+  the own flight, up to a full turn, weighted heavily (`FLIP_RATE_WEIGHT`), so
+  that turning further in the air pays. Until the handover start it was kept
+  even when the attempt crashed or the flight was a hop that never became the
+  jump; `turn_clawback` now takes it back then (`mdp/rewards.py` has why). Half
+  a turn in the air pays 47.
+- `landed_turn`: the flight's rotation, latched at a landing the robot survives
+  and paid every step after it, most for a full turn exactly -- the reward for
+  the flip actually landing, and landing level.
+
+Everything else is `ref_free_jump`'s at its final weights: height, upright,
+HOME after landing, drift, contact and collision penalties, action rate.
+
+## Terminations changed
+
+`ref_free_jump` ends an episode at 50 degrees of tilt (`fell_over`). A flip
+passes through every tilt, so that limit is **removed** and replaced by two
+crash checks (`mdp/terminations.py`):
+
+- `chassis_crash`: any chassis geom -- base, upper shell, camera, ToF, display
+  -- pressing on the ground over 1 N;
+- `tipped_on_feet`: tilt past `GROUNDED_TILT_LIMIT` (80 degrees) while any foot
+  is on the ground.
+
+Time-out and back-at-HOME (a time-out) are unchanged. On the robot the
+controller drops to `safe` at 50 degrees in every mode that does not lift it,
+so a flip needs that guard lifted for its mode (`skip_tilt_check` on its state,
+which `deploy/crabcraft.manifests.json` sets for `power_backflip`): through the
+bundle's controller with the guard in place, the cascade went to `safe` 0.22 s
+after the handover, in the air (`docs/CRABCRAFT_POWER.md`, "Through the bundle's
+controller").
+
+## The handover start
+
+Every HOME spawn starts the way the bundle's controller hands a mode over
+(`power_jumpspin.env_cfg.handover_start`, `power_jumpspin/mdp/handover.py`): up to
+0.1 rad off HOME on every gait joint, held at HOME with the action at zero for
+0.02 to 0.6 s, and handed to the policy with its observation history emptied.
+`pw-flip-T` trained without it and took off only from mjlab's reset, whose first
+observation shows the servo's limit on 18 of the 20 joints' torque; from a
+robot standing at HOME it did not jump at all. Trained on from the handover
+alone it lost the flip and farmed the in-air rate instead, so two more things
+came with it: `turn_clawback` (`mdp/rewards.py`) gives back the rate a hop or a
+crash was paid, and a bridge (`mdp/curriculum.py`, `BRIDGE_SHARE`) starts some of
+the held spawns at mjlab's reset for the first 900 iterations. `pw-flip-brc`,
+resumed from `pw-flip-T`'s `model_2498` on this configuration, is what ships
+(`docs/CRABCRAFT_POWER.md`, "The handover start").
+
+## Symmetry
+
+On, as in `ref_free_jump`: a pitch rotation is its own mirror image.
+"""
+
+from __future__ import annotations
+
+import math
+from pathlib import Path
+
+from mjlab.envs import ManagerBasedRlEnvCfg
+from mjlab.managers import TerminationTermCfg
+from mjlab.managers.curriculum_manager import CurriculumTermCfg
+from mjlab.managers.reward_manager import RewardTermCfg
+from mjlab.sensor import ContactMatch, ContactSensorCfg
+
+from ..common.constants import CHASSIS_LINKS
+from ..power_jumpspin import mdp as turn_mdp
+from ..power_jumpspin.env_cfg import handover_start, settle_after_landing, turning_jump_cfg
+from ..ref_free_jump.rl_cfg import NUM_STEPS_PER_ENV
+from . import mdp as flip_mdp
+
+#: Nose-up pitch rate in the air, per rad/s, until the flight has turned a full
+#: turn: a half turn in the air pays 47.
+#:
+#: 5 was tried first and settled on a hop that leans back. `pw-flip-a` (400
+#: iterations, 4096 envs, H100, warp:cuda), measured on native:cpu with DR off:
+#: 88 degrees nose-up in a 0.34 s flight, then tipped past 80 degrees on its
+#: rear feet. Presumably because a partial flip crashes and loses everything a
+#: landing would go on paying, which at 5 the turn did not make up for -- an
+#: interpretation, not a measurement. At 15, `pw-flip-r15` (1000 iterations,
+#: same setup) turned 418 degrees in
+#: the air and landed on its feet, 4 of 4 with DR off and 29 of 32 with DR on.
+FLIP_RATE_WEIGHT = 15.0
+
+#: The landed flight's rotation, per half turn, paid every step after a landing
+#: it survives; most for a landing exactly a full turn round
+#: (`power_jumpspin/mdp/rewards.py::landed_turn`, `tent`).
+LANDED_TURN_WEIGHT = 4.0
+LANDED_TURN_CAP = 2 * math.pi
+
+#: Tilt past which a foot on the ground ends the attempt. Above the 50 degrees of
+#: the other jumps, so that a take-off leaning back is allowed; below 90, so that
+#: standing on the rear feet with the body vertical or past it is not.
+GROUNDED_TILT_LIMIT = math.radians(80.0)
+
+#: The bridge from mjlab's reset to the handover (`mdp/curriculum.py`): the share
+#: of held HOME spawns started at the reset instead, held until
+#: `BRIDGE_HOLD_ITERATION` and down to 0 at `BRIDGE_END_ITERATION`. Iterations on
+#: the run's own count, which a resumed run continues: the shipped run resumes
+#: `pw-flip-T`'s `model_2498` (its step counter at 2500 iterations' worth), so
+#: about 200 iterations at the full share, 700 coming down and 600 from the
+#: handover alone in a 1500-iteration run. Chosen, not tuned.
+BRIDGE_SHARE = 0.5
+BRIDGE_HOLD_ITERATION = 2700
+BRIDGE_END_ITERATION = 3400
+
+#: The settling charges (`power_jumpspin.env_cfg.settle_after_landing`) at this
+#: times the 720's. The flip landed shaking harder -- 2.98 rad/s against 1.21,
+#: its torque chatter on all 20 joints -- and from `pw-flip-brc` with its noise
+#: capped at 0.15, 950 iterations at the shared weights left it at 0.47 rad/s and
+#: 17 deg/s from the handover (DR on, the median of 16), at twice them at 0.18
+#: and 7.5 (`cm-flip-g` and `cm-flip-g8`, `docs/CRABCRAFT_POWER.md`).
+SETTLE_CHARGE_FACTOR = 2.0
+_SETTLE_CHARGES = ("calm_joint_vel", "calm_action_rate", "calm_torque", "calm_base_ang_vel")
+
+#: The chassis collision geoms: the five links bolted together (`CHASSIS_LINKS`).
+_CHASSIS_GEOMS = tuple(f"{link}_meshcol" for link in CHASSIS_LINKS)
+
+
+def env_cfg(asset: Path | None = None, play: bool = False) -> ManagerBasedRlEnvCfg:
+    """The back-flip probe.
+
+    Args:
+        asset: path to the model XML, from `--model`. None uses the default jumper.xml.
+        play: replay mode -- noise and pushes off, every episode from HOME, handed
+            over after `power_jumpspin.env_cfg.PLAY_HOLD_S` of standing.
+    """
+    cfg = turning_jump_cfg(asset, play, axis="pitch")
+
+    cfg.scene.sensors = (cfg.scene.sensors or ()) + (
+        ContactSensorCfg(
+            name="chassis_ground_contact",
+            primary=ContactMatch(mode="geom", pattern=_CHASSIS_GEOMS, entity="robot"),
+            secondary=ContactMatch(mode="body", pattern="terrain"),
+            fields=("force",),
+            reduce="netforce",
+            num_slots=1,
+        ),
+    )
+
+    cfg.rewards["landed_turn"] = RewardTermCfg(
+        func=turn_mdp.rewards.landed_turn, weight=LANDED_TURN_WEIGHT,
+        params={"command_name": "jump", "scale": math.pi, "cap": LANDED_TURN_CAP,
+                "tent": True},
+    )
+    cfg.rewards["flight_turn_rate"] = RewardTermCfg(
+        func=turn_mdp.rewards.flight_turn_rate, weight=FLIP_RATE_WEIGHT,
+        params={"command_name": "jump", "cap": LANDED_TURN_CAP},
+    )
+    # Turn paid in a flight that was not the jump, or before a crash, is taken
+    # back (`mdp/rewards.py`).
+    cfg.rewards["turn_clawback"] = RewardTermCfg(
+        func=flip_mdp.rewards.turn_clawback, weight=-FLIP_RATE_WEIGHT,
+        params={"command_name": "jump", "cap": LANDED_TURN_CAP},
+    )
+
+    del cfg.terminations["fell_over"]
+    cfg.terminations["chassis_crash"] = TerminationTermCfg(
+        func=flip_mdp.terminations.chassis_crash,
+        params={"sensor_name": "chassis_ground_contact", "force_threshold": 1.0},
+    )
+    cfg.terminations["tipped_on_feet"] = TerminationTermCfg(
+        func=flip_mdp.terminations.tipped_on_feet,
+        params={"limit_angle": GROUNDED_TILT_LIMIT, "sensor_name": "feet_ground_contact"},
+    )
+    cfg = handover_start(cfg, play)
+    if not play:
+        cfg.commands["jump"].reset_share = BRIDGE_SHARE
+        cfg.curriculum["reset_share"] = CurriculumTermCfg(
+            func=flip_mdp.curriculum.anneal_reset_share,
+            params={"command_name": "jump", "start_share": BRIDGE_SHARE, "end_share": 0.0,
+                    "start_step": NUM_STEPS_PER_ENV * BRIDGE_HOLD_ITERATION,
+                    "end_step": NUM_STEPS_PER_ENV * BRIDGE_END_ITERATION},
+        )
+    cfg = settle_after_landing(cfg)
+    for name in _SETTLE_CHARGES:
+        cfg.rewards[name].weight *= SETTLE_CHARGE_FACTOR
+    return cfg
+
+
+__all__ = ["env_cfg"]
