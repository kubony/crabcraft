@@ -0,0 +1,49 @@
+"""jumper.power_spin_feet -- jumper.power_spin with `illegal_contact` at -20.
+
+Everything is `jumper.power_spin`'s (its `env_cfg.py` has the design) but one
+weight: a step on which any part that is not a foot -- a calf, a palm, the shell
+-- presses on the ground costs 20 rather than 5.
+
+## Why a task of its own
+
+`jumper.power_spin` at -5 (`pw-spin-L`) spins at 4.4 rev/s, and 3.1 once its
+calves, palms and shell are given friction 0.4 instead of the plane's 1.0: it
+leans on grip a real floor may not give those parts. At -20 (`pw-spin-c20L`,
+trained from the experiment branch `exp/power-spin-contact20`, 4af8af8, whose one
+change from `jumper.power_spin` is this weight) it spins at 2.3 rev/s, 2.2 at
+friction 0.4, and stays within 0.13 m of its spot (native:cpu, DR off;
+`docs/CRABCRAFT_POWER.md`, "What it leans on"). That is the policy "World of
+Crabcraft" ships, and an export is only reproducible against the task it trained
+on, so the weight is a task here rather than a branch.
+
+`pw-spin-c20L` trained under the id `jumper.power_spin` (its logs say so); the
+configuration this task builds is the one it trained on, field for field.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from mjlab.envs import ManagerBasedRlEnvCfg
+
+from ..power_spin import env_cfg as spin_env
+
+#: Per step with any non-foot part on the ground over 1 N: four times
+#: `jumper.power_spin`'s -5. At -5 `pw-spin-L` touched in 32% to 42% of steps;
+#: at -20 `pw-spin-c20L` touches in a median 14% (native:cpu, DR on, 32 envs).
+ILLEGAL_CONTACT_WEIGHT = -20.0
+
+
+def env_cfg(asset: Path | None = None, play: bool = False) -> ManagerBasedRlEnvCfg:
+    """In-place spin, kept to the feet.
+
+    Args:
+        asset: path to the model XML, from `--model`. None uses the default jumper.xml.
+        play: replay mode -- noise and pushes off, every episode from HOME.
+    """
+    cfg = spin_env.env_cfg(asset=asset, play=play)
+    cfg.rewards["illegal_contact"].weight = ILLEGAL_CONTACT_WEIGHT
+    return cfg
+
+
+__all__ = ["env_cfg"]
