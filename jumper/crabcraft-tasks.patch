@@ -0,0 +1,45 @@
+"""PPO hyperparameters for jumper.power_jumpspin: ref_free_jump's, without the mirror,
+starting from its trained actor."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from mjlab.rl import RslRlOnPolicyRunnerCfg
+
+from ..common.ppo import jumper_ppo_baseline
+from ..ref_free_jump.rl_cfg import NUM_STEPS_PER_ENV
+
+#: The actor every run of this task starts from, unless it resumes its own:
+#: `jumper.ref_free_jump`'s `model_5999` (`2026-09-28_11-54-00`), committed with
+#: that task's example export. See `runner.py`.
+WARM_START = (
+    Path(__file__).resolve().parents[1] / "ref_free_jump" / "out" / "example" / "model_5999.pt"
+)
+
+
+def agent_cfg() -> RslRlOnPolicyRunnerCfg:
+    return jumper_ppo_baseline(
+        experiment_name="jumper.power_jumpspin",
+        # Off: a counter-clockwise turn mirrors to a clockwise one, so the
+        # augmentation would ask for both from the same state.
+        symmetry=False,
+        use_data_augmentation=False,
+        use_mirror_loss=False,
+        actor_hidden_dims=(512, 256, 128, 64),
+        critic_hidden_dims=(512, 256, 128, 64),
+        # Overwritten by the warm start's own noise; used only by a run that
+        # resumes nothing and loads nothing, which this task does not do.
+        init_std=0.3,
+        entropy_coef=0.001,
+        gamma=0.99**0.25,
+        lam=0.95**0.25,
+        num_steps_per_env=NUM_STEPS_PER_ENV,
+        max_iterations=3000,
+    )
+
+
+def runner_cls() -> type:
+    from .runner import warm_start_runner
+
+    return warm_start_runner(WARM_START)
diff --git a/tasks/jumper/power_jumpspin/runner.py b/tasks/jumper/power_jumpspin/runner.py
new file mode 100644
index 0000000..79c1354
--- /dev/null
+++ b/tasks/jumper/power_jumpspin/runner.py
@@ -0,0 +1,68 @@
+"""A runner that starts a new run from another task's trained actor.
+
+The turning jumps are `jumper.ref_free_jump` with a rotation added to its
+objective, and that task has already done the expensive part: its recording,
+fed forward and faded out over 3000 iterations, taught a policy to jump with
+nothing but its body to go on. These tasks start from that actor rather than
+from the recording again.
+
+**The actor only.** The actor's observation is unchanged -- the same six terms,
+the same strided history, 406 wide -- so `model_5999`'s actor, its observation
+normaliser and its action noise load as they are. The critic does not: it sees
+the rotation bookkeeping (`mdp/observations.py`) and none of the recording's
+feedforward, so its input is a different width, and it starts fresh.
+
+**Only when nothing else was loaded.** `scripts/train.py` loads `--checkpoint`
+(or `--resume`) through `load` before it calls `learn`; a run that resumed its
+own checkpoint keeps it. `play.py` and `export.py` call `load` and never `learn`,
+so neither ever sees the warm start.
+
+Nothing of the source's training state comes with it: not its iteration count,
+not its optimiser, and not its environment step counter. The counter is what
+`ref_free_jump`'s schedules read, and these tasks have none -- the feedforward
+and the prior are gone from their configs, not scheduled to zero.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import torch
+from mjlab.rl.runner import MjlabOnPolicyRunner
+
+
+class WarmStartRunner(MjlabOnPolicyRunner):
+    """Loads `warm_start`'s actor before the first `learn`, unless `load` ran.
+
+    A subclass sets `warm_start`; `warm_start_runner` makes one.
+    """
+
+    warm_start: Path
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self._loaded = False
+
+    def load(self, *args, **kwargs):
+        self._loaded = True
+        return super().load(*args, **kwargs)
+
+    def learn(self, *args, **kwargs):
+        if not self._loaded:
+            src = Path(self.warm_start)
+            if not src.is_file():
+                raise FileNotFoundError(f"warm-start checkpoint {src} not found")
+            saved = torch.load(src, map_location=self.device, weights_only=False)
+            self.alg.load(saved, {"actor": True}, strict=True)
+            print(f"[warm start] actor, its normaliser and its noise from {src}; "
+                  f"critic, optimiser and counters fresh")
+            self._loaded = True
+        return super().learn(*args, **kwargs)
+
+
+def warm_start_runner(checkpoint: Path) -> type:
+    """A `WarmStartRunner` subclass that starts from `checkpoint`."""
+    return type("WarmStartRunner", (WarmStartRunner,), {"warm_start": Path(checkpoint)})
+
+
+__all__ = ["WarmStartRunner", "warm_start_runner"]
