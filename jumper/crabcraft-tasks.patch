@@ -0,0 +1,318 @@
+"""Evaluate a jumper.skill_* or jumper.break_* checkpoint in the task's own environment
+(native MuJoCo, CPU).
+
+Run from the jumper repository root with its venv:
+    .venv/bin/python tools/eval_skill.py --move swipe --checkpoint <model_N.pt> --dr off --envs 4 --out <dir>
+    .venv/bin/python tools/eval_skill.py --move swipe --checkpoint <model_N.pt> --dr on  --envs 10 --out <dir>
+    .venv/bin/python tools/eval_skill.py --move sixstep --checkpoint <model_N.pt> --dr on --envs 10 --seed 7 --out <dir>
+
+This is the acceptance check for these tasks, not the training reward: the clips are mostly
+the lead-in, lead-out and hold at HOME, where a robot that never moves already scores part of
+the tracking reward, so a rising reward alone does not show the move was learned. Compare
+`joint_rms_deg_window` with `standstill_rms_deg_window` (docs/CRABCRAFT_SKILLS.md and
+docs/CRABCRAFT_BREAKING.md, "Evaluated"), and `motion_ratio_window` with 1: a policy that
+plays the move at a fraction of its size scores a small RMS against a small move.
+
+The breaking moves' windows come from their clips' own events: the game's window, and for
+the two freezes the held pose (`hit` to `release`), over which the lifted feet are measured
+against the reference's. The six-step's turn is measured as yaw turned and base drift.
+
+Every environment starts at the clip's first frame (HOME, play mode: sampling "start",
+no reference-state perturbation) and runs exactly one pass of the clip. "dr off" removes
+the startup randomisation (base CoM offset, encoder bias, foot friction), the pushes and
+the observation noise; "dr on" keeps the training's: those three, the pushes, and the
+actor's observation noise at the training levels.
+
+Writes <out>/<move>_<dr>.npz (per-step arrays) and prints a JSON line of metrics.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from dataclasses import asdict
+from pathlib import Path
+
+import numpy as np
+import torch
+
+# The move window of each clip, clip seconds: the part the game shows, plus the held
+# pose for the two that hold (docs/CRABCRAFT_SKILLS.md, "The game's windows").
+WINDOWS = {
+    "swipe": (0.00, 0.94),
+    "slam": (0.40, 1.50),
+    "cast": (0.40, 3.10),
+    "flinch": (0.00, 0.46),
+    "powerdown": (0.00, 3.20),
+    "sit": (0.80, 2.90),
+}
+
+# The breaking moves (docs/CRABCRAFT_BREAKING.md, "The game's windows"): the window the
+# game plays, by the names of the clip's own events, read from its media/<move>.npz.
+BREAK_WINDOWS = {
+    "toprock": ("loop_from", "loop_to"),
+    "sixstep": ("turn_from", "turn_to"),
+    "clawstand": ("lift", "recovered"),
+    "oneclaw": ("lift", "recovered"),
+}
+# The freezes' held pose, and the feet the freeze lifts off the floor in it.
+BREAK_HOLDS = {
+    "clawstand": (("hit", "release"), ("LR_foot_tip_link", "RR_foot_tip_link")),
+    "oneclaw": (("hit", "release"), ("LR_foot_tip_link", "RR_foot_tip_link", "RF_palm_pad_b_link")),
+}
+MOVES = sorted(WINDOWS) + sorted(BREAK_WINDOWS)
+
+
+def task_of(move: str) -> str:
+    return f"jumper.break_{move}" if move in BREAK_WINDOWS else f"jumper.skill_{move}"
+
+
+def clip_events(move: str) -> dict:
+    """The clip's `events` (seconds into the clip), from the committed media/<move>.npz."""
+    import tasks
+
+    kind = "break" if move in BREAK_WINDOWS else "skill"
+    path = Path(tasks.__file__).resolve().parent / "jumper" / f"{kind}_{move}" / "media" / f"{move}.npz"
+    with np.load(path) as z:
+        return json.loads(str(z["events"])) if "events" in z.files else {}
+
+
+def quat_up(q: np.ndarray) -> np.ndarray:
+    """Body z axis in world, from (w, x, y, z)."""
+    w, x, y, z = np.moveaxis(q, -1, 0)
+    return np.stack([2 * (x * z + w * y), 2 * (y * z - w * x), 1 - 2 * (x * x + y * y)], -1)
+
+
+def tilt_deg(q: np.ndarray) -> np.ndarray:
+    return np.degrees(np.arccos(np.clip(quat_up(q)[..., 2], -1, 1)))
+
+
+def yaw_deg(q: np.ndarray) -> np.ndarray:
+    """Heading of the body x axis in the world, unwrapped along axis 0 (time), degrees."""
+    w, x, y, z = np.moveaxis(q, -1, 0)
+    yaw = np.arctan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z))
+    return np.degrees(np.unwrap(yaw, axis=0))
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--move", required=True, choices=MOVES)
+    ap.add_argument("--checkpoint", required=True, type=Path)
+    ap.add_argument("--dr", choices=("off", "on"), default="off")
+    ap.add_argument("--envs", type=int, default=4)
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("--out", type=Path, required=True)
+    args = ap.parse_args()
+
+    import mjrl.backend.select as sel
+    from mjrl.backend import resolve
+
+    res = resolve(backend="native", device="cpu", num_envs=args.envs, training=False)
