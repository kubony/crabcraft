new file mode 100644
index 0000000..b9beade
--- /dev/null
+++ b/tasks/jumper/power_backflip/mdp/curriculum.py
@@ -0,0 +1,47 @@
+"""The bridge from mjlab's reset to the handover, for the back flip.
+
+`pw-flip-T` flips only from mjlab's reset, whose first observation shows the
+servo's torque limit on 18 of the 20 joints. Trained from the handover alone it
+loses the flip before it finds a takeoff: `pw-flip-hot` (resumed from
+`pw-flip-T`'s `model_2498`, crashes and hops charged for, 4096 envs, H100,
+warp:cuda) jumped from the handover by iteration 2800 but turned 64 degrees
+there (native:cpu, DR on, 32 of 32 landed) and 53 on average in training at
+3117 -- a landed hop is paid and a partial flip, which crashes, is not, so
+nothing leads from the one to the other; `pw-flip-hop` (crashes kept, hops
+charged) stopped jumping at all by 2764, its entropy falling from 22 to 6.7.
+
+So for a while some of the held HOME spawns start at the reset instead
+(`RotationJumpCommandCfg.reset_share`), where the flip still lands, and the
+share comes down to 0: what the network does after the takeoff keeps being
+paid while it learns to take off from a robot standing at HOME.
+"""
+
+from __future__ import annotations
+
+import torch
+
+
+def anneal_reset_share(
+    env,
+    env_ids: torch.Tensor | None,
+    command_name: str,
+    start_share: float,
+    end_share: float,
+    start_step: int,
+    end_step: int,
+) -> float:
+    """`start_share` until `start_step`, `end_share` from `end_step`, linear between,
+    written into the command's `reset_share`. Steps are the environment's
+    `common_step_counter`, which a resumed run restores. Returns the share, which
+    the curriculum manager logs as `Curriculum/<term>`."""
+    del env_ids
+    if not 0 <= start_step < end_step:
+        raise ValueError(f"need 0 <= start_step < end_step, got {start_step} and {end_step}")
+    s = env.common_step_counter
+    frac = min(max((s - start_step) / (end_step - start_step), 0.0), 1.0)
+    share = start_share + (end_share - start_share) * frac
+    env.command_manager.get_term(command_name).cfg.reset_share = share
+    return share
+
+
+__all__ = ["anneal_reset_share"]
