index 0000000..639b6e0
--- /dev/null
+++ b/tasks/jumper/power_spin_feet/__init__.py
@@ -0,0 +1,24 @@
+"""jumper.power_spin_feet -- jumper.power_spin, charged four times as much for
+touching the ground with anything but a foot.
+
+The spin "World of Crabcraft" ships. `jumper.power_spin` at its weight pivots on
+its middle calves and a claw's palm as much as on its feet, grip the simulator
+gives those parts and a real floor may not; at four times the charge the spin is
+slower and keeps to its feet. See `env_cfg.py`, and `docs/CRABCRAFT_POWER.md`
+for what each reached.
+"""
+
+from __future__ import annotations
+
+from ...registry import register
+from ..common.assets import JUMPER_ASSETS
+
+register(
+    id="jumper.power_spin_feet",
+    assets=JUMPER_ASSETS,
+    description=(
+        "jumper hexapod spinning in place on its feet: jumper.power_spin with "
+        "non-foot ground contact charged four times as much"
+    ),
+    tags=("jumper", "power", "spin", "flat"),
+)
