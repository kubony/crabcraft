+          "policy": "tasks/jumper/five_foot/out/example",
+          "hook": {"side": "right"},
+          "pad": {"button": "RB", "on": "toggle", "from": ["locomotion", "claw_left"]},
+          "keys": {"key": ["key_b"], "on": "toggle", "from": ["locomotion", "claw_left"]}
