+"""jumper.skill_sit -- a resting sit, a keyframed reference learned by imitation.
+
+A one-shot move on the dance machinery, as the gestures are: the environment is
+`tasks/jumper/common/dance/env.py`, and what this directory adds is the clip and
+the numbers.
+
+## The clip
+
+`media/sit.npz`, written by `tools/author_skill_clips.py`, whose docstring has how
+the clip is made and checked; `docs/CRABCRAFT_SKILLS.md` has the numbers it passed
+with. It replaces `sit`, one of the hand keyframes "World of Crabcraft" played
+where every other move is a rollout of a trained policy.
+
+The rear feet step back and out and the middle feet out, in two diagonal pairs;
+the rear lowers until the back of the shell rests on the floor, the nose
+11 degrees up and the claws standing where they stood, a dog's sit. Held from
+1.70 to 2.90 s with one slow breath; then up, the feet step back in, and it
+stands.
+
+The clip begins at `HOME` and ends with a lead-out back to it and half a second
+standing there, 5.32 s in all, so it starts and ends where the walking policy
+stands. The game plays a window of it: sitting from 0.80 s, seated 1.70 to 2.90 s,
+rising 2.90 s, back by 4.40 s.
+
+There is no music, and nothing to export a performance video with: export with
+`--no-video`.
+"""
+
+from __future__ import annotations
+
+from ...registry import register
+from ..common.assets import JUMPER_ASSETS
+
+register(
+    id="jumper.skill_sit",
+    assets=JUMPER_ASSETS,
+    description="jumper hexapod imitating crabcraft's resting sit; the clip is "
+                "committed in tasks/jumper/skill_sit/media/",
+    tags=("imitation", "jumper", "skill", "flat"),
+)
