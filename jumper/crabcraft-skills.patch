diff --git a/tasks/jumper/skill_sit/rl_cfg.py b/tasks/jumper/skill_sit/rl_cfg.py
new file mode 100644
index 0000000..b9ad386
--- /dev/null
+++ b/tasks/jumper/skill_sit/rl_cfg.py
@@ -0,0 +1,49 @@
+"""Hyper-parameters for jumper.skill_sit.
+
+jumper.dance's, value for value, as for the gestures, and for the reasons written
+out in `tasks/jumper/dance/rl_cfg.py`: the network, PPO and runner settings were
+chosen for imitating a clip on this robot, not for that one clip. Written out again
+rather than imported, so that changing one clip's training is a change to that clip.
+"""
+
+from __future__ import annotations
+
+from mjlab.rl import RslRlOnPolicyRunnerCfg
+
+from ..common.ppo import jumper_ppo_baseline
+
+
+def agent_cfg() -> RslRlOnPolicyRunnerCfg:
+    """This task's rsl_rl config: `logs/<model>/jumper.skill_sit/<date-time>`."""
+    return jumper_ppo_baseline(
+        experiment_name="jumper.skill_sit",
+        # Off, and not a tuning choice: the sit is symmetric up to its order
+        # of feet, but `symmetry.py` refuses the reference terms, as for every
+        # dance and gesture.
+        symmetry=False,
+        use_data_augmentation=False,
+        use_mirror_loss=False,
+        actor_hidden_dims=(512, 256, 128, 64),
+        critic_hidden_dims=(512, 256, 128, 64),
+        init_std=1.0,
+        # Half the baseline's: imitation needs less exploration than
+        # locomotion, and a rising `Policy/mean_std` costs precision terms
+        # first.
+        entropy_coef=0.005,
+        learning_rate=1.0e-3,
+        desired_kl=0.01,
+        gamma=0.99,
+        lam=0.95,
+        num_learning_epochs=5,
+        num_mini_batches=4,
+        num_steps_per_env=24,
+        max_iterations=10_000,
+    )
+
+
+def runner_cls() -> type:
+    """mjlab's motion-tracking runner, as jumper.dance: it logs the tracking metrics
+    and the adaptive sampler's entropy, and bakes the clip into the exported ONNX."""
+    from mjlab.tasks.tracking.rl import MotionTrackingOnPolicyRunner
+
+    return MotionTrackingOnPolicyRunner
diff --git a/tasks/jumper/skill_slam/__init__.py b/tasks/jumper/skill_slam/__init__.py
new file mode 100644
index 0000000..3f3879c
--- /dev/null
+++ b/tasks/jumper/skill_slam/__init__.py
@@ -0,0 +1,39 @@
+"""jumper.skill_slam -- crabcraft's two-claw slam, a keyframed reference learned by imitation.
+
+A one-shot move on the dance machinery, as the gestures are: the environment is
+`tasks/jumper/common/dance/env.py`, and what this directory adds is the clip and
+the numbers.
+
+## The clip
+
+`media/slam.npz`, written by `tools/author_skill_clips.py`, whose docstring has how
+the clip is made and checked; `docs/CRABCRAFT_SKILLS.md` has the numbers it passed
+with. It replaces `attack_slam`, one of the hand keyframes "World of Crabcraft" played
+where every other move is a rollout of a trained policy.
+
+The robot rocks 40 mm back onto its middle and rear legs, which is what lets
+both claws leave the floor (the centre of mass sits ahead of the middle
+feet), rears up with both claws high and open, and brings them down onto the
+floor in front, the shell pitching nose-down into the impact. The claws step
+forward to where they stand at `HOME` before the body comes forward.
+
+The clip begins at `HOME` and ends with a lead-out back to it and half a second
+standing there, 3.38 s in all, so it starts and ends where the walking policy
+stands. The game plays a window of it: windup 0.90 s, hit 1.12 s, recovered 1.50 s.
+
+There is no music, and nothing to export a performance video with: export with
+`--no-video`.
+"""
+
+from __future__ import annotations
+
+from ...registry import register
+from ..common.assets import JUMPER_ASSETS
+
+register(
+    id="jumper.skill_slam",
+    assets=JUMPER_ASSETS,
+    description="jumper hexapod imitating crabcraft's two-claw slam; the clip is "
+                "committed in tasks/jumper/skill_slam/media/",
+    tags=("imitation", "jumper", "skill", "flat"),
+)
diff --git a/tasks/jumper/skill_slam/env_cfg.py b/tasks/jumper/skill_slam/env_cfg.py
new file mode 100644
index 0000000..1be2e65
--- /dev/null
+++ b/tasks/jumper/skill_slam/env_cfg.py
@@ -0,0 +1,117 @@
+"""Environment config for jumper.skill_slam: crabcraft's two-claw slam, `media/slam.npz`.
+
+The environment is `tasks/jumper/common/dance/env.py`; this file holds every
+number. Where a number follows a rule `jumper.dance` wrote down for its own clip,
+the rule is applied to this clip's measurements and the result is quoted -- read
+`tasks/jumper/dance/env_cfg.py` for the reasoning behind each rule.
+
+## This clip, measured
+
+At the 50 Hz control rate, after conversion (3.38 s, lead-out and hold included):
+per-joint position std 0.116 rad at the median and 0.596 at the most active, RMS
+amplitude 0.251 rad; joint velocity RMS 1.647 rad/s, per-joint std 0.739 at the
+median and 3.552 at the most active, peaking at 16.5 rad/s; the base between
+94 and 120 mm; tilt at most 10.3 degrees.
+
+**The reward weights are starting points**, as they are for jumper.dance: no policy
+has been trained on this clip in this repository yet.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from mjlab.envs import ManagerBasedRlEnvCfg
+
+from ..common.dance.env import dance_env_cfg
+
+#: This task's material, written by `tools/author_skill_clips.py`.
+MEDIA = Path(__file__).resolve().parent / "media"
+
+#: Episode length, seconds. Half the 3.38 s clip, jumper.dance_maze's rule for a
+#: short clip: the command teleports the robot back onto the reference wherever an
+#: episode runs off the end, and at half the clip an episode sampled in its first
+#: half runs clean.
+EPISODE_S = 1.69
+
+
+def env_cfg(asset: Path | None = None, play: bool = False) -> ManagerBasedRlEnvCfg:
+    """Build this task's environment config. See `jumper.dance`'s for the arguments."""
+    return dance_env_cfg(
+        media=MEDIA,
+        asset=asset,
+        play=play,
+        episode_s=EPISODE_S,
+        # ── Reference-state initialisation ────────────────────────────────
+        # jumper.dance's: fractions of this robot (10 mm is a tenth of its
+        # standing height), not of the clip, so they carry over unchanged.
+        rsi_pose_range={
+            "x": (-0.01, 0.01), "y": (-0.01, 0.01), "z": (-0.005, 0.005),
+            "roll": (-0.05, 0.05), "pitch": (-0.05, 0.05), "yaw": (-0.05, 0.05),
+        },
+        rsi_velocity_range={
+            "x": (-0.1, 0.1), "y": (-0.1, 0.1), "z": (-0.05, 0.05),
+            "roll": (-0.2, 0.2), "pitch": (-0.2, 0.2), "yaw": (-0.2, 0.2),
+        },
+        rsi_joint_range=(-0.05, 0.05),
+        # ── Observation noise ─────────────────────────────────────────────
+        # The tracking skeleton's, as jumper.dance has them; not measured.
+        joint_pos_noise=0.01,
+        joint_vel_noise=0.5,
+        # ── Rewards ───────────────────────────────────────────────────────
+        # Positive budget 6.5 a step, as jumper.dance: mjlab's six tracking
+        # terms unchanged (5.0) plus the two joint-space terms below (1.5).
+        #
+        # Joint position: jumper.dance's rule is a std at 0.44 of the clip's
+        # RMS amplitude. Here: 0.44 x 0.251 -> 0.11. Standing still through
+        # the whole clip scores 0.332, far above the dances' 0.006, and that
+        # is the clip, not the rule: 1.56 of its 3.38 s are the way back to
+        # HOME and the hold there, where standing still *is* tracking. Over
+        # the move alone, 1.82 s, standing still scores 0.110.
+        joint_pos_std=0.11,
+        joint_pos_weight=1.0,
+        # Joint velocity: two thirds of the clip's velocity RMS. Here: 1.647
+        # -> 1.1, and over the moving half of the clip standing still scores
+        # 0.308. Half the position weight, so when they disagree the pose
+        # wins.
+        joint_vel_std=1.1,
+        joint_vel_weight=0.5,
+        # Smoothness: -0.1 is calibrated at this action scale (0.25) and the
+        # second difference at half of it -- properties of the robot and the
+        # action space, not of the clip.
+        action_rate_weight=-0.1,
+        action_acc_weight=-0.05,
+        # Power: 22 joints at ~0.25 N*m and this clip's ~1.65 rad/s is ~9.1 W,
+        # so -0.02 is about -0.18 a step, 2.8% of the budget -- jumper.dance's
+        # weight.
+        power_weight=-0.02,
+        # Torque above the continuous rating: anchored to the servo, not the
+        # clip -- one joint at the plateau costs 0.6, 9% of the budget.
+        torque_headroom_weight=-2.0,
+        # Joint limits. The reference stays inside the soft joint limits but
+        # for one joint: `RR_J2_joint`, the right rear knee, is 1 mrad past
+        # its soft limit for a few rows around 0.44 s, where the body is
+        # furthest back: 0.01 a step at this weight, for those rows.
+        joint_limit_weight=-10.0,
+        # Leg-on-leg contact above 1.0 N, ~8% of the robot's worst-case push.
+        self_collision_weight=-1.0,
+        self_collision_force=1.0,
+        # ── Terminations ──────────────────────────────────────────────────
+        # Root height: this clip moves the body through 94-120 mm, a 26 mm
+        # band, so 40 mm exceeds all of it and cannot fire on a policy merely
+        # tracking badly -- jumper.dance's rule, and its number.
+        anchor_height_error=0.04,
+        # 1 - cos(tilt) = 0.3 is 45.6 degrees, "has fallen over"; the clip
+        # leans 10.3.
+        anchor_tilt_error=0.3,
+        # A support foot 50 mm out vertically is half the standing height.
+        support_foot_error=0.05,
+        # ── Disturbance ───────────────────────────────────────────────────
+        # jumper.dance's: gentler and rarer than mjlab's, sized to a 2 kg
+        # robot.
+        push_interval_s=(3.0, 8.0),
+        push_velocity_range={
+            "x": (-0.1, 0.1), "y": (-0.1, 0.1), "z": (-0.05, 0.05),
+            "roll": (-0.2, 0.2), "pitch": (-0.2, 0.2), "yaw": (-0.2, 0.2),
+        },
+    )
